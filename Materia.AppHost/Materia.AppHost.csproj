<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>fe5a2ba6-6501-4272-ba02-6f1bf1f2d865</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="9.5.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.5.0" />
    <!-- Override the vulnerable MessagePack 2.5.192 pulled transitively by Aspire 9.5.0 hosting
         packages (NU1903 / GHSA-hv8m-jj95-wg3x, fixed in 2.5.301). Stay on the v2 line to avoid
         the breaking 3.x jump. Remove once the Aspire.Hosting.* packages are bumped to a release
         whose transitive MessagePack is patched. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Materia.Backend\Materia.WebApi\Materia.WebApi.csproj" />
    <ProjectReference Include="..\Materia.WebUi\Materia.WebUi\Materia.WebUi.csproj" />
  </ItemGroup>

</Project>
