# Materia production environment.
#
# NOTE: TLS and reverse-proxy are now handled by the shared EDGE stack (Caddy) in the
# `vps-infra` repo — this stack no longer runs Caddy/Watchtower. The domains below are still
# used by the app itself (WebUi__BaseUrl / ApiService__BaseUrl / email links) and by the edge
# Caddyfile for the vhosts, so they must resolve to the VPS.

# ── GitHub Container Registry ──────────────────────────────────────────────
# Your GitHub username (lowercase). Images are pulled from:
#   ghcr.io/YOUR_GITHUB_USERNAME/materia-webapi:latest
#   ghcr.io/YOUR_GITHUB_USERNAME/materia-webui:latest
GHCR_PREFIX=ghcr.io/YOUR_GITHUB_USERNAME

# ── Domains ────────────────────────────────────────────────────────────────
# Both must have A records pointing to this VPS IP before first deploy.
# The edge Caddy obtains TLS certificates automatically via Let's Encrypt.
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Redis ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── JWT signing key ─────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS

# ── Voyage AI (embeddings for semantic product search / RAG) ────────────────
# Leave blank to disable embedding backfill; the rest of the app runs fine without it.
VOYAGE_API_KEY=

# ── Email (Brevo SMTP) ──────────────────────────────────────────────────────
# FromAddress must be a verified sender/domain in Brevo, or mail is rejected.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
