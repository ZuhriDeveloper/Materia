FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file first for restore layer caching
COPY Materia.WebUi/Materia.WebUi/Materia.WebUi.csproj Materia.WebUi/Materia.WebUi/
RUN dotnet restore Materia.WebUi/Materia.WebUi/Materia.WebUi.csproj

COPY Materia.WebUi/ Materia.WebUi/
# Do NOT add --no-restore here. The framework static-web-assets package
# 'microsoft.aspnetcore.app.internal.assets' (which ships blazor.web.js / blazor.server.js)
# is only added to the restore graph during publish — the earlier `dotnet restore` step
# does not pull it. With --no-restore on a clean machine (CI), it is silently skipped, so
# blazor.web.js never ships and the app 404s it in production. Dev machines hide this because
# the package is already in the global NuGet cache from other projects. Letting publish
# restore pulls it; the bulk of packages are already cached from the restore layer, so the
# extra cost is negligible.
RUN dotnet publish Materia.WebUi/Materia.WebUi/Materia.WebUi.csproj \
    -c Release -o /app/publish

# Guard: blazor.web.js is the script the browser loads to boot the Blazor Web App. If the
# server-side static web assets ever fail to publish (leaving only the WASM client assets),
# the app 404s this file and renders a blank page. Fail the IMAGE BUILD here instead of
# shipping a broken container that silently breaks in production behind the proxy.
RUN test -s /app/publish/wwwroot/_framework/blazor.web.js \
    || (echo "BUILD FAILED: /app/publish/wwwroot/_framework/blazor.web.js missing or empty — Blazor Web App static assets did not publish." && exit 1)

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
# X-Forwarded-* handling is configured in code (Program.cs: UseForwardedHeaders with the
# loopback-only proxy allowlist cleared). Do NOT also set ASPNETCORE_FORWARDEDHEADERS_ENABLED
# here — that registers the middleware a second time and would double-process the headers.
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "Materia.WebUi.dll"]
