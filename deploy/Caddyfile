# Caddy terminates TLS (auto Let's Encrypt) and reverse-proxies to the containers over the
# internal Docker network. `reverse_proxy` already does everything this app needs:
#   * proxies EVERY path, including /_framework/* (blazor.web.js + the static-asset endpoints)
#   * upgrades the Blazor Interactive Server SignalR WebSocket (/_blazor) transparently —
#     no manual Upgrade/Connection headers required (that's an Nginx-ism, see deploy/nginx/)
#   * sets X-Forwarded-Proto/-Host/-For, which Program.cs now trusts (UseForwardedHeaders)
#   * streams responses (no buffering), so the SignalR circuit stays alive
# `encode gzip` is safe: Caddy skips responses that already carry Content-Encoding, so it does
# not double-compress the pre-compressed .br/.gz assets that MapStaticAssets serves.
{$APP_DOMAIN} {
    encode gzip
    reverse_proxy webui:8080
}

{$API_DOMAIN} {
    encode gzip
    reverse_proxy webapi:8080
}

# ── Renovin (separate repo/stack on the same VPS) ─────────────────────────────
# Renovin.Web runs in its own compose stack and joins the shared external `edge`
# network, so this Caddy reaches it by service name. Renovin's API stays private to
# that stack (no public block here). To expose it later for the mobile app, add:
#   api.renovin.co.id { encode gzip; reverse_proxy apiservice:8080 }
# and attach Renovin's `apiservice` to the `edge` network too.
renovin.co.id {
    encode gzip
    reverse_proxy renovin-web:8080
}

www.renovin.co.id {
    redir https://renovin.co.id{uri} permanent
}
