@page "/sales/{id:guid}"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject SaleApiClient     Api
@inject NavigationManager Navigation
@inject IJSRuntime        JS

<PageTitle>@(_sale?.ReferenceNo ?? "Penjualan") — Materia</PageTitle>

@if (_sale is null)
{
    <div class="text-muted">
        <span class="spinner-border spinner-border-sm me-1"></span> Memuat…
    </div>
}
else
{
    @* ── Header ── *@
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <a href="/sales" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <h4 class="mb-0 fw-bold font-monospace flex-grow-1">@_sale.ReferenceNo</h4>
        @StatusBadge(_sale.Status)

        @* ── Print button ── *@
        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="PrintAsync">
            <i class="bi bi-printer me-1"></i>
            @(IsSuratJalan ? "Cetak Surat Jalan" : "Cetak Bon")
        </button>
    </div>

    @if (_justFinalized)
    {
        <div class="alert alert-success alert-dismissible">
            <i class="bi bi-check-circle me-1"></i>
            Penjualan berhasil diselesaikan dan stok telah diperbarui.
            <button type="button" class="btn-close" @onclick="() => _justFinalized = false"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    <div class="row g-4">

        @* ── Items ── *@
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-box-seam me-1"></i> Item
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Produk</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Harga</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _sale.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.ProductName</span>
                                        <span class="badge text-bg-light border ms-1 small">
                                            @item.UnitName
                                        </span>
                                    </td>
                                    <td class="text-center">@item.Quantity.ToString("G29")</td>
                                    <td class="text-end">Rp @item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end fw-semibold">Rp @item.Subtotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total</td>
                                <td class="text-end fw-bold">Rp @_sale.GrandTotal.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (_sale.Payment is not null)
            {
                <div class="card mt-3">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-cash-coin me-1"></i> Pembayaran
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-5 text-muted fw-normal">Metode</dt>
                            <dd class="col-7">@_sale.Payment.Method</dd>
                            <dt class="col-5 text-muted fw-normal">Dibayar</dt>
                            <dd class="col-7">Rp @_sale.Payment.PaidAmount.ToString("N0")</dd>
                            @if (_sale.OutstandingAmount > 0)
                            {
                                <dt class="col-5 text-muted fw-normal">Sisa Piutang</dt>
                                <dd class="col-7 fw-bold text-warning">Rp @_sale.OutstandingAmount.ToString("N0")</dd>
                            }
                            else
                            {
                                <dt class="col-5 text-muted fw-normal">Kembalian</dt>
                                <dd class="col-7">Rp @_sale.Payment.Change.ToString("N0")</dd>
                            }
                        </dl>
                    </div>
                </div>
            }
        </div>

        @* ── Info + actions ── *@
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header fw-semibold">Informasi</div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted fw-normal">Pelanggan</dt>
                        <dd class="col-7 fw-semibold">@_sale.CustomerName</dd>

                        <dt class="col-5 text-muted fw-normal">Pengiriman</dt>
                        <dd class="col-7">
                            @if (_sale.IsDeliveryRequired || _sale.SaleType == SaleType.Delivery)
                            {
                                <span class="badge text-bg-info">
                                    <i class="bi bi-truck me-1"></i> Ya
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ambil di toko</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(_sale.DeliveryAddress))
                        {
                            <dt class="col-5 text-muted fw-normal">Alamat</dt>
                            <dd class="col-7">@_sale.DeliveryAddress</dd>
                        }

                        <dt class="col-5 text-muted fw-normal">Dilayani</dt>
                        <dd class="col-7">@(_sale.ServedBy ?? _sale.CreatedBy)</dd>

                        <dt class="col-5 text-muted fw-normal">Tanggal</dt>
                        <dd class="col-7">
                            @_sale.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </dd>
                    </dl>
                </div>

                @if (CanCancel)
                {
                    <div class="card-footer d-grid">
                        @if (!_showCancel)
                        {
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => _showCancel = true"
                                    disabled="@_saving">
                                <i class="bi bi-x-circle me-1"></i> Batalkan Penjualan
                            </button>
                        }
                        else
                        {
                            <label class="form-label small">Alasan pembatalan</label>
                            <textarea class="form-control form-control-sm mb-2" rows="2"
                                      @bind="_cancelReason"></textarea>
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => _showCancel = false"
                                        disabled="@_saving">
                                    Batal
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="HandleCancel"
                                        disabled="@(_saving || string.IsNullOrWhiteSpace(_cancelReason))">
                                    Ya, Batalkan
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
}

@* ══════════════════════════════════════════════════════════════
   PRINT TEMPLATE — Hidden on screen; visible during window.print().
   Branch A : standard thermal receipt (80mm, Courier New)
   Branch B : Surat Jalan / Delivery Order (A5, Arial)
   ══════════════════════════════════════════════════════════════ *@
<div class="receipt-print-only @(IsSuratJalan ? "is-surat-jalan" : "")">
    @if (_sale is not null)
    {
        @if (IsSuratJalan)
        {
            @* ══════════════════════════════════════════════
               BRANCH B — SURAT JALAN (DELIVERY ORDER)  A5
               ══════════════════════════════════════════════ *@

            @* ─── Store header ─────────────────────────── *@
            <div style="text-align:center;border-bottom:2px solid #000;
                        padding-bottom:3mm;margin-bottom:4mm">
                <div style="font-size:16pt;font-weight:700;letter-spacing:1px">MATERIA</div>
                <div style="font-size:10pt;font-weight:600">BUILDING MATERIALS</div>
                <div style="font-size:9pt;margin-top:1mm">Jl. Raya Bahan Bangunan No. 1</div>
            </div>

            @* ─── Document title ───────────────────────── *@
            <div style="text-align:center;font-size:14pt;font-weight:700;
                        letter-spacing:.5px;margin-bottom:5mm">
                SURAT JALAN (DELIVERY ORDER)
            </div>

            @* ─── Document meta ────────────────────────── *@
            <table style="width:100%;border-collapse:collapse;font-size:9.5pt;margin-bottom:5mm">
                <tr>
                    <td style="width:30%;padding:1mm 0">No.</td>
                    <td>: <b>@_sale.ReferenceNo</b></td>
                </tr>
                <tr>
                    <td style="padding:1mm 0">Tanggal</td>
                    <td>: @_sale.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy HH:mm")</td>
                </tr>
                <tr>
                    <td style="padding:1mm 0">Diproses Oleh</td>
                    <td>: @(_sale.ServedBy ?? _sale.CreatedBy)</td>
                </tr>
            </table>

            @* ─── Customer info block ──────────────────── *@
            <div style="border:1px solid #000;padding:3mm;margin-bottom:5mm;font-size:9.5pt">
                <div style="font-weight:700;font-size:10pt;margin-bottom:2mm">KEPADA YTH.</div>
                <table style="width:100%;border-collapse:collapse">
                    <tr>
                        <td style="width:30%;vertical-align:top;padding:1mm 0">Nama</td>
                        <td style="vertical-align:top">: <b>@_sale.CustomerName</b></td>
                    </tr>
                    <tr>
                        <td style="vertical-align:top;padding:1mm 0">Alamat</td>
                        <td style="vertical-align:top">
                            : @(!string.IsNullOrWhiteSpace(_sale.DeliveryAddress)
                                ? _sale.DeliveryAddress : "—")
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:1mm 0">Telepon</td>
                        <td>: —</td>
                    </tr>
                </table>
            </div>

            @* ─── Delivery details ─────────────────────── *@
            <div style="border:1px solid #000;padding:3mm;margin-bottom:5mm;font-size:9.5pt">
                <div style="font-weight:700;font-size:10pt;margin-bottom:2mm">
                    KETERANGAN PENGIRIMAN
                </div>
                <table style="width:100%;border-collapse:collapse">
                    <tr>
                        <td style="width:30%;padding:2mm 0">No. Polisi</td>
                        <td>
                            : <span style="border-bottom:1px solid #000;
                                           display:inline-block;min-width:55mm">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:2mm 0">Nama Sopir</td>
                        <td>
                            : <span style="border-bottom:1px solid #000;
                                           display:inline-block;min-width:55mm">&nbsp;</span>
                        </td>
                    </tr>
                </table>
            </div>

            @* ─── Item table ───────────────────────────── *@
            <table style="width:100%;border-collapse:collapse;font-size:9.5pt;margin-bottom:5mm">
                <thead>
                    <tr style="border-top:2px solid #000;border-bottom:1px solid #000">
                        <th style="text-align:center;padding:2mm;width:8%">No.</th>
                        <th style="text-align:left;padding:2mm">Nama Barang</th>
                        <th style="text-align:center;padding:2mm;width:18%">Jumlah</th>
                        <th style="text-align:center;padding:2mm;width:14%">Satuan</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _sale.Items.Count; i++)
                    {
                        var it = _sale.Items[i];
                        <tr style="border-bottom:1px solid #ddd">
                            <td style="text-align:center;padding:2mm 1mm;vertical-align:top">
                                @(i + 1).
                            </td>
                            <td style="padding:2mm 1mm;font-weight:600;vertical-align:top">
                                @it.ProductName
                            </td>
                            <td style="text-align:center;padding:2mm 1mm;vertical-align:top">
                                @it.Quantity.ToString("0.###")
                            </td>
                            <td style="text-align:center;padding:2mm 1mm;vertical-align:top">
                                @it.UnitName
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="border-top:2px solid #000">
                        <td colspan="3"
                            style="padding:2mm;text-align:right;font-weight:700;font-size:10pt">
                            TOTAL
                        </td>
                        <td colspan="1"
                            style="padding:2mm;font-weight:700;font-size:10pt;text-align:center">
                            Rp @_sale.GrandTotal.ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>

            @* ─── 3-column signature matrix ────────────── *@
            <table style="width:100%;border-collapse:collapse;text-align:center;
                          font-size:9pt;margin-top:10mm">
                <tr>
                    <td style="width:33%;border:1px solid #000;padding:2mm;font-weight:700">
                        Penyiapan Barang<br />
                        <span style="font-weight:400;font-size:8.5pt">(Gudang)</span>
                    </td>
                    <td style="width:34%;border:1px solid #000;border-left:none;
                               padding:2mm;font-weight:700">
                        Pengirim Barang<br />
                        <span style="font-weight:400;font-size:8.5pt">(Sopir)</span>
                    </td>
                    <td style="width:33%;border:1px solid #000;border-left:none;
                               padding:2mm;font-weight:700">
                        Penerima Barang<br />
                        <span style="font-weight:400;font-size:8.5pt">(Pelanggan)</span>
                    </td>
                </tr>
                <tr>
                    <td style="border:1px solid #000;border-top:none;height:28mm"></td>
                    <td style="border:1px solid #000;border-top:none;border-left:none;
                               height:28mm"></td>
                    <td style="border:1px solid #000;border-top:none;border-left:none;
                               height:28mm"></td>
                </tr>
                <tr>
                    <td style="border:1px solid #000;border-top:none;padding:2mm;font-size:8pt">
                        (______________________)
                    </td>
                    <td style="border:1px solid #000;border-top:none;border-left:none;
                               padding:2mm;font-size:8pt">
                        (______________________)
                    </td>
                    <td style="border:1px solid #000;border-top:none;border-left:none;
                               padding:2mm;font-size:8pt">
                        (______________________)
                    </td>
                </tr>
            </table>
        }
        else
        {
            @* ══════════════════════════════════════════════
               BRANCH A — STANDARD RECEIPT (80mm thermal)
               ══════════════════════════════════════════════ *@

            @* ─── Store header ─────────────────────────── *@
            <div style="text-align:center;margin-bottom:3mm">
                <div style="font-size:13pt;font-weight:700;letter-spacing:.5px">MATERIA</div>
                <div style="font-size:8.5pt;font-weight:600">BUILDING MATERIALS</div>
                <div style="font-size:7.5pt;margin-top:1mm">Jl. Raya Bahan Bangunan No. 1</div>
            </div>

            @* ─── Meta ─────────────────────────────────── *@
            <div style="border-top:2px solid #000;border-bottom:1px dashed #000;
                        padding:2mm 0;margin-bottom:2mm;font-size:7.5pt">
                <table style="width:100%;border-collapse:collapse">
                    <tr>
                        <td style="width:28%">No.</td>
                        <td>: <b>@_sale.ReferenceNo</b></td>
                    </tr>
                    <tr>
                        <td>Tgl.</td>
                        <td>: @_sale.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <td>Kasir</td>
                        <td>: @(_sale.ServedBy ?? _sale.CreatedBy)</td>
                    </tr>
                    <tr>
                        <td>Plg.</td>
                        <td>: @_sale.CustomerName</td>
                    </tr>
                </table>
            </div>

            @* ─── Item lines ────────────────────────────── *@
            <div style="border-bottom:1px dashed #000;padding-bottom:2mm;margin-bottom:2mm">
                @foreach (var item in _sale.Items)
                {
                    <div style="margin-bottom:1.5mm">
                        <div style="font-weight:600;font-size:8.5pt;
                                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                            @item.ProductName
                        </div>
                        <div style="display:flex;justify-content:space-between;
                                    font-size:8pt;padding-left:3mm">
                            <span>
                                @item.Quantity.ToString("0.###") @item.UnitName
                                &times; @item.UnitPrice.ToString("N0")
                            </span>
                            <span style="font-weight:600">@item.Subtotal.ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>

            @* ─── Totals ────────────────────────────────── *@
            <div style="font-size:8pt;margin-bottom:1mm">
                <div style="display:flex;justify-content:space-between">
                    <span>Subtotal</span>
                    <span>@_sale.Subtotal.ToString("N0")</span>
                </div>
                @{
                    var adjustment = _sale.GrandTotal - _sale.Subtotal;
                }
                @if (adjustment > 0)
                {
                    <div style="display:flex;justify-content:space-between">
                        <span>Pajak / Lainnya</span>
                        <span>@adjustment.ToString("N0")</span>
                    </div>
                }
                else if (adjustment < 0)
                {
                    <div style="display:flex;justify-content:space-between">
                        <span>Diskon</span>
                        <span>@adjustment.ToString("N0")</span>
                    </div>
                }
            </div>

            <div style="border-top:2px solid #000;border-bottom:2px solid #000;
                        padding:1.5mm 0;margin-bottom:3mm;
                        display:flex;justify-content:space-between;
                        font-size:11pt;font-weight:700">
                <span>TOTAL</span>
                <span>Rp @_sale.GrandTotal.ToString("N0")</span>
            </div>

            @* ─── Payment info ──────────────────────────── *@
            @if (_sale.Payment is not null)
            {
                <div style="font-size:7.5pt;margin-bottom:3mm">
                    <div style="display:flex;justify-content:space-between">
                        <span>Metode</span>
                        <span>@_sale.Payment.Method</span>
                    </div>
                    <div style="display:flex;justify-content:space-between">
                        <span>Bayar</span>
                        <span>Rp @_sale.Payment.PaidAmount.ToString("N0")</span>
                    </div>
                    @if (_sale.OutstandingAmount > 0)
                    {
                        <div style="display:flex;justify-content:space-between;font-weight:700">
                            <span>Sisa Piutang</span>
                            <span>Rp @_sale.OutstandingAmount.ToString("N0")</span>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;justify-content:space-between;font-weight:700">
                            <span>Kembali</span>
                            <span>Rp @_sale.Payment.Change.ToString("N0")</span>
                        </div>
                    }
                </div>
            }

            @* ─── Delivery notice ───────────────────────── *@
            @if (_sale.IsDeliveryRequired || _sale.SaleType == SaleType.Delivery)
            {
                <div style="border:2px solid #000;padding:2mm;margin-bottom:3mm;
                            text-align:center;font-size:8.5pt;font-weight:700">
                    *** DIANTAR ***
                    <div style="font-weight:400;margin-top:2mm;font-size:8pt">
                        Tanda Tangan Penerima:
                        <div style="border-bottom:1px solid #000;margin-top:5mm;
                                    width:60%;margin-left:auto;margin-right:auto"></div>
                    </div>
                </div>
            }

            @* ─── Footer ────────────────────────────────── *@
            <div style="text-align:center;font-size:7.5pt;margin-top:3mm">
                <div>- - - - - - - - - - - - - - - - -</div>
                <div style="margin:2mm 0">
                    Terima kasih atas kunjungan<br />
                    dan kepercayaan Anda!
                </div>
                <div>- - - - - - - - - - - - - - - - -</div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "finalized")] public string? Finalized { get; set; }

    private SaleDto? _sale;
    private bool     _justFinalized;
    private bool     _showCancel;
    private string   _cancelReason = "";
    private string?  _error;
    private bool     _saving;

    private bool CanCancel => _sale is not null
        && _sale.Status is not SaleStatus.Paid and not SaleStatus.Cancelled;

    protected override async Task OnInitializedAsync()
    {
        _justFinalized = Finalized == "1";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _sale = await Api.GetSaleByIdAsync(Id);
        if (_sale is null) Navigation.NavigateTo("/sales");
    }

    /// Registered customer + delivery = Surat Jalan; walk-in or no delivery = standard receipt.
    private bool IsSuratJalan => _sale?.CustomerId is not null
        && (_sale.IsDeliveryRequired || _sale.SaleType == SaleType.Delivery);

    private async Task PrintAsync()
        => await JS.InvokeVoidAsync("printReceipt", IsSuratJalan);

    private async Task HandleCancel()
    {
        _saving = true;
        _error  = null;
        var error = await Api.CancelAsync(Id, _cancelReason);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _showCancel = false;
        await LoadAsync();
    }

    private static MarkupString StatusBadge(SaleStatus status) => status switch
    {
        SaleStatus.Draft         => (MarkupString)"<span class='badge bg-warning text-dark'>Draft</span>",
        SaleStatus.Confirmed     => (MarkupString)"<span class='badge bg-primary'>Selesai</span>",
        SaleStatus.Paid          => (MarkupString)"<span class='badge bg-success'>Lunas</span>",
        SaleStatus.PartiallyPaid => (MarkupString)"<span class='badge bg-warning text-dark'>Piutang (Bon)</span>",
        SaleStatus.Cancelled     => (MarkupString)"<span class='badge bg-danger'>Dibatalkan</span>",
        _                        => (MarkupString)"<span class='badge bg-secondary'>—</span>",
    };
}
