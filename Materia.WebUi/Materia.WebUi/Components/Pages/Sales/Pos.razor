@page "/pos"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Materia.WebUi.Services
@using MudBlazor
@inject SaleApiClient           SaleApi
@inject InventoryApiClient      InventoryApi
@inject CustomerApiClient       CustomerApi
@inject StoreSettingsApiClient  StoreApi
@inject NavigationManager       Navigation
@inject IJSRuntime              JS
@implements IAsyncDisposable

<PageTitle>Kasir — Materia</PageTitle>

@* ══════════════════════════════════════════════════════════════
   SALE COMPLETED STATE
   ══════════════════════════════════════════════════════════════ *@
@if (_saleFinalized && _receipt is not null)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="py-8">

        <MudIcon Icon="@(_receipt.IsCredit ? Icons.Material.Filled.ReceiptLong : Icons.Material.Filled.CheckCircle)"
                 Color="@(_receipt.IsCredit ? Color.Warning : Color.Success)"
                 Style="font-size:5rem" />

        <div class="text-center">
            <MudText Typo="Typo.h5" Style="font-weight:700">
                @(_receipt.IsCredit ? "Bon / Piutang Tercatat!" : "Penjualan Berhasil!")
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">
                <b>@_receipt.ReferenceNo</b> &nbsp;·&nbsp;
                @_receipt.IssuedAt.ToString("dd MMM yyyy, HH:mm")
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Pelanggan: @_receipt.CustomerName
                &nbsp;·&nbsp;
                Grand Total: <b>Rp @_receipt.GrandTotal.ToString("N0")</b>
            </MudText>

            @if (_receipt.IsCredit)
            {
                <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="mt-3 flex-wrap">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Payments">
                        Dibayar (DP): Rp @_receipt.AmountPaid.ToString("N0")
                    </MudChip>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.AccountBalanceWallet">
                        Sisa Piutang: Rp @_receipt.Outstanding.ToString("N0")
                    </MudChip>
                </MudStack>
            }
            else if (_receipt.Change > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    Dibayar (@_receipt.PaymentMethodLabel): <b>Rp @_receipt.AmountPaid.ToString("N0")</b>
                    &nbsp;·&nbsp; Kembali: <b>Rp @_receipt.Change.ToString("N0")</b>
                </MudText>
            }
        </div>

        <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="flex-wrap">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="@(async () => await JS.InvokeVoidAsync("printReceipt", _receipt!.IsSuratJalan))">
                @(_receipt!.IsSuratJalan ? "Cetak Surat Jalan" : "Cetak Bon")
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddShoppingCart"
                       OnClick="StartNewSale">
                Transaksi Baru
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.OpenInNew"
                       Href="@($"/sales/{_receipt.SaleId}")">
                Lihat Detail
            </MudButton>
        </MudStack>

    </MudStack>
}
else
{
    @* ══════════════════════════════════════════════════════════
       NORMAL POS UI
       ══════════════════════════════════════════════════════════ *@

    @* Page header *@
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Style="font-weight:700">
            <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-2 mb-1" />Kasir
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ListAlt"
                   Href="/sales">
            Daftar Penjualan
        </MudButton>
    </div>

    <MudGrid Spacing="3">

        @* ── Left: scan + table ── *@
        <MudItem xs="12" lg="8">

            <MudPaper Outlined="true" Class="pa-3 mb-3 rounded-lg">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode2" Size="Size.Small" Class="mr-1" />
                    Pindai / Cari Produk
                </MudText>
                <div class="d-flex gap-2 align-center">
                    <MudAutocomplete T="ProductSearchDto"
                                     @ref="_autocompleteRef"
                                     Value="_selectedProduct"
                                     ValueChanged="OnProductSelected"
                                     SearchFunc="SearchProductsAsync"
                                     ToStringFunc="@(p => p?.Name ?? string.Empty)"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     Label="Barcode, nama, atau SKU produk…"
                                     Variant="Variant.Outlined"
                                     Dense="true"
                                     Clearable="true"
                                     Immediate="true"
                                     DebounceInterval="180"
                                     MinCharacters="1"
                                     MaxItems="8"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary"
                                     Class="flex-grow-1">
                        <ItemTemplate Context="p">
                            <div class="d-flex justify-space-between align-center px-1 py-0">
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;line-height:1.3">@p.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @p.BaseUnit &nbsp;·&nbsp; Rp @p.SalePrice.ToString("N0")@(p.Variants is { Count: > 0 } ? $" · {p.Variants.Count} warna" : "")
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Tertiary"
                                         Style="font-family:monospace">@p.Sku</MudText>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>
                    <MudTooltip Text="Pindai dengan kamera" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       OnClick="ScanAsync" />
                    </MudTooltip>
                </div>
                @if (!string.IsNullOrEmpty(_scanMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 py-1"
                              Icon="@Icons.Material.Filled.ErrorOutline">
                        @_scanMessage
                    </MudAlert>
                }
            </MudPaper>

            <MudPaper Outlined="true" Class="rounded-lg" Style="overflow:hidden">
                <div class="d-flex justify-space-between align-center px-4 py-2"
                     style="border-bottom:1px solid var(--mud-palette-divider)">
                    <MudText Typo="Typo.subtitle2">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />Item
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                        @_lines.Count
                    </MudChip>
                </div>

                @if (_lines.Count == 0)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-10">
                        <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner"
                                 Size="Size.Large" Color="Color.Secondary"
                                 Style="font-size:3rem;opacity:.35" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            Belum ada item. Pindai barcode atau ketik nama produk untuk menambah.
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudTable T="CartLine"
                              Items="_lines"
                              Dense="true"
                              Hover="true"
                              FixedHeader="true"
                              Height="@(_lines.Count > 9 ? "440px" : null)"
                              Elevation="0"
                              Style="background:transparent">
                        <ColGroup>
                            <col style="width:36px" />
                            <col />
                            <col style="width:100px" />
                            <col style="width:92px" />
                            <col style="width:128px" />
                            <col style="width:110px" />
                            <col style="width:44px" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh Style="padding:6px 8px">#</MudTh>
                            <MudTh Style="padding:6px 8px">Produk</MudTh>
                            <MudTh Style="padding:6px 8px">SKU</MudTh>
                            <MudTh Style="padding:6px 8px;text-align:center">Qty</MudTh>
                            <MudTh Style="padding:6px 8px;text-align:right">Harga (Rp)</MudTh>
                            <MudTh Style="padding:6px 8px;text-align:right">Total</MudTh>
                            <MudTh Style="padding:6px 4px"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="padding:4px 8px">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(_lines.IndexOf(context) + 1)
                                </MudText>
                            </MudTd>
                            <MudTd Style="padding:4px 8px">
                                <MudText Typo="Typo.body2" Style="font-weight:600;line-height:1.3">
                                    @context.ProductName
                                </MudText>
                                @if (context.Units.Count > 1)
                                {
                                    <MudSelect T="string"
                                               Value="@context.UnitName"
                                               ValueChanged="@(u => OnUnitChanged(context, u))"
                                               Dense="true" Margin="Margin.Dense"
                                               Variant="Variant.Text"
                                               Style="max-width:148px;font-size:.75rem;margin-top:1px">
                                        @foreach (var u in context.Units)
                                        {
                                            <MudSelectItem T="string" Value="@u.UnitName">
                                                @u.UnitName — Rp @u.SalePrice.ToString("N0")
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="Color.Default"
                                             Style="height:18px;font-size:.68rem;margin:2px 0 0">
                                        @context.UnitName
                                    </MudChip>
                                }
                                @if (context.Variants.Count > 0)
                                {
                                    <MudSelect T="Guid?"
                                               Value="@context.VariantId"
                                               ValueChanged="@(v => OnVariantChanged(context, v))"
                                               Dense="true" Margin="Margin.Dense"
                                               Variant="Variant.Text"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Palette"
                                               Style="max-width:170px;font-size:.75rem;margin-top:1px">
                                        @foreach (var cv in context.Variants)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)cv.VariantId)">
                                                @cv.ColorName — Rp @cv.EffectivePrice.ToString("N0")
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudTd>
                            <MudTd Style="padding:4px 8px">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="font-family:monospace">@context.Sku</MudText>
                            </MudTd>
                            <MudTd Style="padding:4px 8px;text-align:center">
                                <MudNumericField T="decimal"
                                                 Value="@context.Quantity"
                                                 ValueChanged="@(v => OnQtyChanged(context, v))"
                                                 Min="0m" Step="1m"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="false" Style="width:76px" />
                            </MudTd>
                            <MudTd Style="padding:4px 8px;text-align:right">
                                <MudNumericField T="decimal"
                                                 Value="@context.UnitPrice"
                                                 ValueChanged="@(v => OnPriceChanged(context, v))"
                                                 Min="0m" Step="500m" Format="N0"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Style="width:112px" />
                            </MudTd>
                            <MudTd Style="padding:4px 8px;text-align:right">
                                <MudText Typo="Typo.body2" Style="font-weight:700">
                                    Rp @context.Total.ToString("N0")
                                </MudText>
                            </MudTd>
                            <MudTd Style="padding:4px 4px">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => _lines.Remove(context))"
                                               Title="Hapus" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>

        </MudItem>

        @* ── Right: metadata + summary ── *@
        <MudItem xs="12" lg="4">
            <div style="position:sticky;top:72px">

                <MudPaper Outlined="true" Class="pa-4 mb-3 rounded-lg">
                    <MudSelect T="Guid?"
                               Value="_customerId"
                               ValueChanged="OnCustomerChanged"
                               Label="Pelanggan"
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter"
                               Class="mb-3">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Walk-in (Umum)</MudSelectItem>
                        @if (_customers is not null)
                        {
                            @foreach (var c in _customers)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">
                                    @c.Name — @c.Phone@(c.OutstandingDebt > 0 ? $" · Piutang: Rp {c.OutstandingDebt:N0}" : "")
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_servedBy"
                                  Label="Dilayani oleh"
                                  Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  Class="mb-3" />
                    <div class="d-flex align-center justify-space-between">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping"
                                     Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">Perlu pengiriman</MudText>
                        </div>
                        <MudSwitch @bind-Value="_isDeliveryRequired"
                                   Color="Color.Primary" Disabled="@IsWalkIn" />
                    </div>
                    @if (IsWalkIn)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            Pilih pelanggan terdaftar untuk mengaktifkan pengiriman.
                        </MudText>
                    }
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                        Ringkasan
                    </MudText>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
                    }
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Subtotal</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            Rp @Subtotal.ToString("N0")
                        </MudText>
                    </div>
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Diskon (Rp)</MudText>
                        <MudNumericField T="decimal"
                                         Value="_discount" ValueChanged="OnDiscountChanged"
                                         Min="0m" Step="500m" Format="N0"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HideSpinButtons="true" Style="width:116px" />
                    </div>
                    <div class="d-flex align-center justify-space-between mb-1">
                        <div class="d-flex align-center gap-1">
                            <MudSwitch @bind-Value="_taxEnabled" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">PPN 11 %</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            Rp @TaxAmount.ToString("N0")
                        </MudText>
                    </div>
                    <MudDivider Class="my-3" />
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.h6" Style="font-weight:700">Grand Total</MudText>
                        <MudText Style="font-size:1.4rem;font-weight:800;
                                       color:var(--mud-palette-success)">
                            Rp @GrandTotal.ToString("N0")
                        </MudText>
                    </div>

                    @* ── Payment ──────────────────────────────────────────── *@
                    <MudSelect T="PaymentMethod"
                               Value="_paymentMethod"
                               ValueChanged="@(m => _paymentMethod = m)"
                               Label="Metode pembayaran"
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Payments"
                               Class="mb-2">
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.Cash">Tunai</MudSelectItem>
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.BankTransfer">Transfer Bank</MudSelectItem>
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.QRIS">QRIS</MudSelectItem>
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.Debit">Kartu Debit</MudSelectItem>
                    </MudSelect>

                    <div class="d-flex align-center justify-space-between mb-1">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.CreditScore"
                                     Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Penjualan kredit (Bon)</MudText>
                        </div>
                        <MudSwitch T="bool" Value="_isCredit" ValueChanged="OnCreditToggled"
                                   Color="Color.Warning" Disabled="@IsWalkIn" />
                    </div>
                    @if (IsWalkIn)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                            Pilih pelanggan terdaftar untuk penjualan dengan piutang.
                        </MudText>
                    }

                    @if (_isCredit)
                    {
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Uang Muka (DP)</MudText>
                            <MudNumericField T="decimal"
                                             Value="_downPayment" ValueChanged="OnDownPaymentChanged"
                                             Min="0m" Max="GrandTotal" Step="10000m" Format="N0"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Style="width:140px" />
                        </div>
                        <div class="d-flex justify-space-between align-center mb-3">
                            <MudText Typo="Typo.body2" Style="font-weight:700">Sisa Piutang</MudText>
                            <MudText Typo="Typo.h6"
                                     Style="font-weight:800;color:var(--mud-palette-warning)">
                                Rp @Outstanding.ToString("N0")
                            </MudText>
                        </div>
                    }
                    else if (_paymentMethod == PaymentMethod.Cash)
                    {
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Jumlah Bayar (Rp)</MudText>
                            <MudNumericField T="decimal?"
                                             Value="_amountTendered"
                                             ValueChanged="OnAmountTenderedChanged"
                                             Min="0m" Step="1000m" Format="N0"
                                             Placeholder="@GrandTotal.ToString("N0")"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Style="width:140px" />
                        </div>
                        @if (_amountTendered.HasValue && _amountTendered.Value > 0 && _amountTendered.Value < GrandTotal)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2 py-1">
                                Uang bayar kurang
                            </MudAlert>
                        }
                        else if (_amountTendered.HasValue && _amountTendered.Value >= GrandTotal)
                        {
                            <div class="d-flex justify-space-between align-center mb-3">
                                <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--mud-palette-success)">
                                    Kembalian
                                </MudText>
                                <MudText Typo="Typo.h6"
                                         Style="font-weight:800;color:var(--mud-palette-success)">
                                    Rp @((_amountTendered.Value - GrandTotal).ToString("N0"))
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3"></div>
                        }
                    }
                    else
                    {
                        <div class="mb-3"></div>
                    }

                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="@(_isCredit ? Color.Warning : Color.Success)"
                               Size="Size.Large"
                               StartIcon="@(_isCredit ? Icons.Material.Filled.ReceiptLong : Icons.Material.Filled.CheckCircle)"
                               OnClick="FinalizeAsync"
                               Disabled="@(_lines.Count == 0 || _processing || IsCashInsufficient)"
                               Style="font-size:.95rem;font-weight:700;height:48px">
                        @if (_processing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                 Class="mr-2" Color="Color.Inherit" />
                        }
                        @(_isCredit ? "Simpan & Buat Bon" : "Selesaikan Penjualan")
                    </MudButton>
                    @if (_lines.Count > 0)
                    {
                        <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Error"
                                   Class="mt-1"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="ClearAll" Disabled="@_processing">
                            Kosongkan
                        </MudButton>
                    }
                </MudPaper>

            </div>
        </MudItem>

    </MudGrid>
}

@* Print template — shared component (compact Surat Jalan + 80mm thermal). *@
@if (_printSaleDto is not null)
{
    <SaleDocumentPrint Sale="_printSaleDto" StoreProfile="_storeProfile" StoreLogo="_storeLogo"
                       CustomerPhone="@(_receipt?.CustomerPhone)" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // ── Store profile (for print header) ─────────────────────────────────────
    private StoreProfileDto? _storeProfile;
    private string?          _storeLogo;

    // ── Data ─────────────────────────────────────────────────────────────────
    private List<CustomerDto>?  _customers;
    private ProductSearchDto?   _selectedProduct;
    private MudAutocomplete<ProductSearchDto>? _autocompleteRef;

    private Guid?   _customerId;
    private string? _customerName;
    private string  _servedBy = "";
    private bool    _isDeliveryRequired;

    private bool IsWalkIn => _customerId is null;

    private string? _scanMessage;
    private IJSObjectReference? _scanner;

    private readonly List<CartLine> _lines = [];

    private decimal _discount;
    private bool    _taxEnabled;
    private string? _error;
    private bool    _processing;

    // ── Receipt / completion ─────────────────────────────────────────────────
    private ReceiptSnapshot? _receipt;        // drives the on-screen success summary
    private SaleDto?         _printSaleDto;    // drives the shared print component
    private bool _saleFinalized;

    // ── Computed totals ──────────────────────────────────────────────────────
    private decimal Subtotal       => _lines.Sum(l => l.Total);
    private decimal DiscountAmount => Math.Clamp(_discount, 0m, Subtotal);
    // PPN rounding mirrors the server (MidpointRounding.AwayFromZero) so the displayed and
    // printed Grand Total exactly match the persisted amount and the recorded debt.
    private decimal TaxAmount      => _taxEnabled
        ? Math.Round((Subtotal - DiscountAmount) * 0.11m, 0, MidpointRounding.AwayFromZero)
        : 0m;
    private decimal GrandTotal     => Subtotal - DiscountAmount + TaxAmount;

    // ── Payment / credit (Bon) ───────────────────────────────────────────────
    private bool          _isCredit;
    private decimal       _downPayment;
    private decimal?      _amountTendered;       // cash-in from cashier input (null = exact)
    private PaymentMethod _paymentMethod = PaymentMethod.Cash;

    /// Amount tendered now: for credit = DP; for cash = tendered if entered else GrandTotal;
    /// for non-cash non-credit = exact GrandTotal.
    private decimal AmountPaid =>
        _isCredit
            ? Math.Clamp(_downPayment, 0m, GrandTotal)
            : _paymentMethod == PaymentMethod.Cash && _amountTendered is > 0
                ? _amountTendered.Value
                : GrandTotal;

    /// Remaining customer debt (piutang) for a credit sale.
    private decimal Outstanding => Math.Max(0m, GrandTotal - AmountPaid);

    /// True when cashier has typed a cash amount that is below the grand total.
    private bool IsCashInsufficient =>
        !_isCredit
        && _paymentMethod == PaymentMethod.Cash
        && _amountTendered is > 0
        && _amountTendered.Value < GrandTotal;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _servedBy = state.User.Identity?.Name ?? "";
        }
        _customers = (await CustomerApi.GetCustomersAsync(isActive: true))?.Items ?? [];

        // Load store profile and logo for print headers (tolerate missing logo).
        try
        {
            _storeProfile = await StoreApi.GetProfileAsync();
            if (_storeProfile?.HasLogo == true)
                _storeLogo = await StoreApi.GetLogoDataUrlAsync();
        }
        catch { /* store data is optional for print; degrade gracefully */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _scanner = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-scanner.js");
        await FocusScanAsync();
    }

    // ── Search ───────────────────────────────────────────────────────────────
    private async Task<IEnumerable<ProductSearchDto>> SearchProductsAsync(
        string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value)) return [];
        try
        {
            return await InventoryApi.SearchProductsAsync(value, 8, ct);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — MudAutocomplete cancels the in-flight request.
            // Expected; just drop this result set.
            return [];
        }
        catch (Exception ex)
        {
            // A real failure (network, auth, server). Surface it instead of silently showing
            // an empty dropdown, which looks like "no products found".
            _scanMessage = $"Pencarian gagal: {ex.Message}";
            await InvokeAsync(StateHasChanged);
            return [];
        }
    }

    private async Task OnProductSelected(ProductSearchDto? product)
    {
        if (product is null) return;
        AddOrIncrement(product);
        _selectedProduct = null;
        _scanMessage     = null;
        await FocusScanAsync();
    }

    // ── Camera scan ──────────────────────────────────────────────────────────
    private async Task ScanAsync()
    {
        if (_scanner is null) return;
        var code = await _scanner.InvokeAsync<string>("startScan");
        if (string.IsNullOrWhiteSpace(code)) return;

        var results = await InventoryApi.SearchProductsAsync(code, 5);

        // 1) A scanned color-variant barcode adds that exact color.
        foreach (var p in results)
        {
            var variant = (p.Variants ?? []).FirstOrDefault(
                v => v.Barcode?.Equals(code, StringComparison.OrdinalIgnoreCase) == true);
            if (variant is not null)
            {
                AddOrIncrement(p, variant);
                _scanMessage = null;
                await FocusScanAsync();
                return;
            }
        }

        // 2) Otherwise match the product by its own barcode / SKU.
        var match = results.FirstOrDefault(p =>
                        p.Sku.Equals(code, StringComparison.OrdinalIgnoreCase) ||
                        p.Barcode?.Equals(code, StringComparison.OrdinalIgnoreCase) == true)
                 ?? (results.Count == 1 ? results[0] : null);

        if (match is not null) { AddOrIncrement(match); _scanMessage = null; }
        else _scanMessage = $"Produk \"{code}\" tidak ditemukan.";

        await FocusScanAsync();
    }

    private async Task FocusScanAsync()
    {
        if (_autocompleteRef is null) return;
        try { await _autocompleteRef.FocusAsync(); }
        catch { /* element not ready */ }
    }

    // ── Cart mutation ────────────────────────────────────────────────────────
    private void AddOrIncrement(ProductSearchDto product, ProductVariantSearchDto? variant = null)
    {
        var variants = product.Variants ?? [];
        // A product with color variants is sold as a specific color — default to the first.
        variant ??= variants.FirstOrDefault();

        var units    = product.Units is { Count: > 0 }
                       ? product.Units
                       : [new ProductUnitPriceDto(product.BaseUnit, product.SalePrice)];
        var baseUnit = units[0];

        // A chosen variant's effective price wins for the base unit.
        var unitPrice = variant?.EffectivePrice ?? baseUnit.SalePrice;

        var existing = _lines.FirstOrDefault(
            l => l.ProductId == product.Id
              && l.VariantId == variant?.VariantId
              && l.UnitName == baseUnit.UnitName);
        if (existing is not null) { existing.Quantity += 1; return; }

        _lines.Add(new CartLine
        {
            ProductId   = product.Id,
            VariantId   = variant?.VariantId,
            ProductName = product.Name,
            ColorName   = variant?.ColorName,
            Sku         = product.Sku,
            UnitName    = baseUnit.UnitName,
            Quantity    = 1,
            UnitPrice   = unitPrice,
            Units       = units,
            Variants    = variants,
        });
    }

    // ── Header / line change handlers ────────────────────────────────────────
    private void OnCustomerChanged(Guid? id)
    {
        _customerId = id;
        if (id is null)
        {
            // Walk-in cannot buy on credit — drop back to a full-payment sale.
            _customerName       = null;
            _isDeliveryRequired = false;
            _isCredit           = false;
            _downPayment        = 0m;
            return;
        }
        var c = _customers?.FirstOrDefault(x => x.Id == id);
        _customerName = c?.Name;
    }

    private void OnUnitChanged(CartLine line, string unitName)
    {
        var unit = line.Units.FirstOrDefault(u => u.UnitName == unitName);
        if (unit is null) return;
        line.UnitName  = unit.UnitName;
        line.UnitPrice = unit.SalePrice;
    }

    private void OnVariantChanged(CartLine line, Guid? variantId)
    {
        var variant = line.Variants.FirstOrDefault(v => v.VariantId == variantId);
        if (variant is null) return;
        line.VariantId = variant.VariantId;
        line.ColorName = variant.ColorName;
        line.UnitPrice = variant.EffectivePrice;
    }

    private void OnQtyChanged(CartLine line, decimal qty)
    {
        if (qty <= 0) { _lines.Remove(line); return; }
        line.Quantity = qty;
    }

    private void OnPriceChanged(CartLine line, decimal price)
        => line.UnitPrice = price < 0 ? 0 : price;

    private void OnDiscountChanged(decimal value)
    {
        _discount = value < 0 ? 0 : value;
        // Keep the DP within the (possibly lowered) grand total.
        if (_downPayment > GrandTotal) _downPayment = GrandTotal;
    }

    private void OnCreditToggled(bool value)
    {
        _isCredit = value;
        if (!value) _downPayment = 0m;
    }

    private void OnAmountTenderedChanged(decimal? value)
        => _amountTendered = value is > 0 ? value : null;

    private void OnDownPaymentChanged(decimal value)
        => _downPayment = Math.Clamp(value, 0m, GrandTotal);

    // ── Finalize ─────────────────────────────────────────────────────────────
    private async Task FinalizeAsync()
    {
        if (_lines.Count == 0 || _processing) return;

        // Business rule: a credit (bon) sale requires a registered customer.
        if (_isCredit && IsWalkIn)
        {
            _error = "Penjualan dengan piutang (bon) hanya untuk pelanggan terdaftar.";
            return;
        }

        _processing = true;
        _error      = null;

        var items = _lines
            .Select(l => new FinalizeSaleItemInput(
                l.ProductId, l.ProductName, l.UnitName, l.Quantity, l.UnitPrice,
                l.VariantId, l.ColorName))
            .ToList();

        var (result, error) = await SaleApi.FinalizeAsync(
            _customerId, _customerName, items, _isDeliveryRequired,
            DiscountAmount, _taxEnabled, AmountPaid, _paymentMethod);

        _processing = false;
        if (error is not null) { _error = error; return; }

        // Lookup customer details for Surat Jalan (phone + default address)
        var customer    = _customerId.HasValue
            ? _customers?.FirstOrDefault(x => x.Id == _customerId.Value)
            : null;
        var defaultAddr = customer?.Addresses.FirstOrDefault(a => a.IsDefault)
                          ?? customer?.Addresses.FirstOrDefault();
        var addrText    = defaultAddr is not null
            ? string.Join(", ",
                new[] { defaultAddr.Street, defaultAddr.City, defaultAddr.Province }
                .Where(s => !string.IsNullOrWhiteSpace(s)))
            : null;

        // Snapshot before any state mutation
        _receipt = new ReceiptSnapshot(
            ReferenceNo         : result!.ReferenceNo,
            SaleId              : result.SaleId,
            IssuedAt            : DateTime.Now,
            ServedBy            : string.IsNullOrWhiteSpace(_servedBy) ? "—" : _servedBy,
            CustomerName        : _customerName ?? "Walk-in (Umum)",
            CustomerPhone       : customer?.Phone,
            CustomerAddress     : addrText,
            IsRegisteredCustomer: _customerId is not null,
            IsDeliveryRequired  : _isDeliveryRequired,
            Subtotal            : Subtotal,
            Discount            : DiscountAmount,
            Tax                 : TaxAmount,
            GrandTotal          : result.GrandTotal,
            AmountPaid          : result.AmountPaid,
            Change              : result.Change,
            Outstanding         : result.OutstandingAmount,
            IsCredit            : result.IsCredit,
            PaymentMethod       : _paymentMethod
        );

        // Build the SaleDto the shared print component renders from.
        _printSaleDto = new SaleDto(
            Id:                 result.SaleId,
            ReferenceNo:        result.ReferenceNo,
            CustomerId:         _customerId,
            CustomerName:       _customerName ?? "Walk-in (Umum)",
            CustomerAddressId:  null,
            DeliveryAddress:    addrText,
            SaleType:           _isDeliveryRequired ? SaleType.Delivery : SaleType.Pickup,
            Status:             result.IsCredit ? SaleStatus.PartiallyPaid : SaleStatus.Paid,
            IsDeliveryRequired: _isDeliveryRequired,
            Subtotal:           Subtotal,
            Discount:           DiscountAmount,
            Tax:                TaxAmount,
            GrandTotal:         result.GrandTotal,
            AmountPaid:         result.AmountPaid,
            OutstandingAmount:  result.OutstandingAmount,
            CreatedBy:          _servedBy,
            ServedBy:           string.IsNullOrWhiteSpace(_servedBy) ? "—" : _servedBy,
            CreatedAt:          DateTime.Now,
            Payment:            new SalePaymentDto(
                                    result.AmountPaid, result.Change,
                                    result.OutstandingAmount, _paymentMethod, DateTime.Now),
            Items:              _lines.Select(l => new SaleItemDto(
                                    Guid.NewGuid(), l.ProductId, l.ProductName, l.UnitName,
                                    l.Quantity, l.Quantity, l.UnitPrice, l.Total,
                                    l.VariantId, l.ColorName)).ToList());

        _saleFinalized = true;
    }

    // ── New sale ─────────────────────────────────────────────────────────────
    private void StartNewSale()
    {
        _lines.Clear();
        _discount           = 0;
        _taxEnabled         = false;
        _isCredit           = false;
        _downPayment        = 0m;
        _amountTendered     = null;
        _paymentMethod      = PaymentMethod.Cash;
        _scanMessage        = null;
        _error              = null;
        _customerId         = null;
        _customerName       = null;
        _isDeliveryRequired = false;
        _receipt            = null;
        _printSaleDto       = null;
        _saleFinalized      = false;
    }

    private async Task ClearAll()
    {
        _lines.Clear();
        _discount       = 0;
        _taxEnabled     = false;
        _isCredit       = false;
        _downPayment    = 0m;
        _amountTendered = null;
        _scanMessage    = null;
        _error          = null;
        await FocusScanAsync();
    }

    // ── Dispose ──────────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        if (_scanner is null) return;
        try { await _scanner.DisposeAsync(); }
        catch { /* circuit already torn down */ }
    }

    // ── Inner types ──────────────────────────────────────────────────────────
    private sealed class CartLine
    {
        public Guid    ProductId   { get; init; }
        public Guid?   VariantId   { get; set; }
        public string  ProductName { get; init; } = "";
        public string? ColorName   { get; set; }
        public string  Sku         { get; init; } = "";
        public string  UnitName    { get; set; }  = "";
        public decimal Quantity    { get; set; }
        public decimal UnitPrice   { get; set; }
        public IReadOnlyList<ProductUnitPriceDto> Units { get; init; } = [];
        public IReadOnlyList<ProductVariantSearchDto> Variants { get; init; } = [];
        public decimal Total => Quantity * UnitPrice;
    }

    private sealed record ReceiptSnapshot(
        string   ReferenceNo,
        Guid     SaleId,
        DateTime IssuedAt,
        string   ServedBy,
        string   CustomerName,
        string?  CustomerPhone,
        string?  CustomerAddress,
        bool     IsRegisteredCustomer,
        bool     IsDeliveryRequired,
        decimal  Subtotal,
        decimal  Discount,
        decimal  Tax,
        decimal  GrandTotal,
        decimal  AmountPaid,
        decimal  Change,
        decimal  Outstanding,
        bool     IsCredit,
        PaymentMethod PaymentMethod)
    {
        /// Surat Jalan condition: registered customer + delivery required.
        /// Walk-in buyers with delivery → simple receipt with "*** DIANTAR ***".
        public bool IsSuratJalan => IsRegisteredCustomer && IsDeliveryRequired;

        public string PaymentMethodLabel => PaymentMethod switch
        {
            Materia.WebUi.Services.PaymentMethod.Cash         => "Tunai",
            Materia.WebUi.Services.PaymentMethod.BankTransfer => "Transfer Bank",
            Materia.WebUi.Services.PaymentMethod.QRIS         => "QRIS",
            Materia.WebUi.Services.PaymentMethod.Debit        => "Kartu Debit",
            Materia.WebUi.Services.PaymentMethod.Credit       => "Kredit",
            _                                                 => PaymentMethod.ToString(),
        };
    }
}
