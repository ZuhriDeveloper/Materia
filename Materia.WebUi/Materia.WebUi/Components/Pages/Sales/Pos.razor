@page "/pos"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Materia.WebUi.Services
@inject SaleApiClient      SaleApi
@inject InventoryApiClient InventoryApi
@inject CustomerApiClient  CustomerApi
@inject NavigationManager  Navigation
@inject IJSRuntime         JS
@implements IAsyncDisposable

<PageTitle>Kasir — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-shop me-2"></i>Kasir</h4>
    <a href="/sales" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-list-ul me-1"></i> Daftar Penjualan
    </a>
</div>

@* ── Header / metadata ── *@
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Pelanggan</label>
                <select class="form-select" @onchange="OnCustomerChanged">
                    <option value="">Walk-in (Umum)</option>
                    @if (_customers is not null)
                    {
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.Name — @c.Phone</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Dilayani oleh</label>
                <input class="form-control" @bind="_servedBy" placeholder="Nama staf" />
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch fs-5 mt-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="deliverySwitch" @bind="_isDeliveryRequired"
                           disabled="@IsWalkIn" />
                    <label class="form-check-label fs-6" for="deliverySwitch">
                        <i class="bi bi-truck me-1"></i> Perlu pengiriman
                    </label>
                </div>
                @if (IsWalkIn)
                {
                    <div class="form-text small">Pilih pelanggan terdaftar untuk pengiriman.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">

    @* ── Left: scan zone + items ── *@
    <div class="col-lg-8">

        @* Scan / SKU zone *@
        <div class="card mb-3 border-primary-subtle">
            <div class="card-body">
                <label class="form-label fw-semibold mb-1">
                    <i class="bi bi-upc-scan me-1"></i> Pindai / Cari Produk
                </label>
                <div class="position-relative">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-upc"></i></span>
                        <input class="form-control pos-scan-input"
                               placeholder="Pindai barcode atau ketik nama / SKU produk…"
                               autocomplete="off"
                               @ref="_codeInputRef"
                               value="@_codeInput"
                               @oninput="OnSearchInput"
                               @onkeydown="OnKeyDown" />
                        <button class="btn btn-primary px-3" @onclick="ScanAsync" title="Pindai dengan kamera">
                            <i class="bi bi-camera me-1"></i> Pindai
                        </button>
                        <button class="btn btn-outline-primary px-3" @onclick="AddFromInputAsync"
                                disabled="@string.IsNullOrWhiteSpace(_codeInput)">
                            <i class="bi bi-plus-lg me-1"></i> Tambah
                        </button>
                    </div>

                    @* Autocomplete suggestions (served from Redis) *@
                    @if (_showSuggestions && _suggestions.Count > 0)
                    {
                        <div class="list-group pos-suggestions shadow-sm">
                            @for (var i = 0; i < _suggestions.Count; i++)
                            {
                                var idx = i;
                                var p   = _suggestions[i];
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(idx == _highlightIndex ? "active" : "")"
                                        @onclick="() => SelectSuggestionAsync(p)">
                                    <span>
                                        <span class="fw-semibold">@p.Name</span>
                                        <span class="badge text-bg-light border ms-1">@p.BaseUnit</span>
                                    </span>
                                    <code class="small @(idx == _highlightIndex ? "text-white" : "text-muted")">@p.Sku</code>
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_scanMessage))
                {
                    <div class="text-danger small mt-2">
                        <i class="bi bi-exclamation-circle me-1"></i> @_scanMessage
                    </div>
                }
            </div>
        </div>

        @* Items table *@
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-cart3 me-1"></i> Item</span>
                <span class="badge text-bg-secondary">@_lines.Count</span>
            </div>
            <div class="card-body p-0">
                @if (_lines.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-upc-scan fs-1 d-block mb-2 opacity-50"></i>
                        Belum ada item. Pindai barcode atau ketik nama produk untuk menambah.
                    </div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0 pos-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width:34px"></th>
                                <th>Produk</th>
                                <th>SKU</th>
                                <th class="text-center" style="width:120px">Qty</th>
                                <th class="text-end" style="width:150px">Harga</th>
                                <th class="text-end" style="width:140px">Total</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _lines)
                            {
                                <tr @key="line">
                                    <td class="text-muted small">@(_lines.IndexOf(line) + 1)</td>
                                    <td>
                                        <div class="fw-semibold">@line.ProductName</div>
                                        @if (line.Units.Count > 1)
                                        {
                                            <select class="form-select form-select-sm mt-1" style="max-width:150px"
                                                    @onchange="e => OnUnitChanged(line, e)">
                                                @foreach (var u in line.Units)
                                                {
                                                    <option value="@u.UnitName" selected="@(u.UnitName == line.UnitName)">
                                                        @u.UnitName — Rp @u.SalePrice.ToString("N0")
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light border small">@line.UnitName</span>
                                        }
                                    </td>
                                    <td><code class="text-muted">@line.Sku</code></td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               min="0" step="0.001"
                                               value="@line.Quantity"
                                               @onchange="e => OnQtyChanged(line, e)" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-end"
                                               min="0" step="100"
                                               value="@line.UnitPrice"
                                               @onchange="e => OnPriceChanged(line, e)" />
                                    </td>
                                    <td class="text-end fw-semibold">Rp @line.Total.ToString("N0")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" title="Hapus"
                                                @onclick="() => _lines.Remove(line)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @* ── Right: summary ── *@
    <div class="col-lg-4">
        <div class="card sticky-top" style="top:1rem">
            <div class="card-header fw-semibold"><i class="bi bi-receipt me-1"></i> Ringkasan</div>
            <div class="card-body">

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 small">@_error</div>
                }

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span class="fw-semibold">Rp @Subtotal.ToString("N0")</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Diskon (Rp)</span>
                    <input type="number" class="form-control form-control-sm text-end" style="width:8rem"
                           min="0" step="500" value="@_discount"
                           @onchange="OnDiscountChanged" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">
                        <div class="form-check form-switch d-inline-block me-1">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="taxSwitch" @bind="_taxEnabled" />
                        </div>
                        <label for="taxSwitch">PPN 11%</label>
                    </span>
                    <span class="fw-semibold">Rp @TaxAmount.ToString("N0")</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <span class="fw-bold">Grand Total</span>
                    <span class="pos-total text-success">Rp @GrandTotal.ToString("N0")</span>
                </div>

                <button class="btn btn-success btn-lg w-100"
                        @onclick="FinalizeAsync"
                        disabled="@(_lines.Count == 0 || _processing)">
                    @if (_processing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>
                    }
                    Selesaikan Penjualan
                </button>

                @if (_lines.Count > 0)
                {
                    <button class="btn btn-link text-danger w-100 mt-1" @onclick="ClearAll" disabled="@_processing">
                        Kosongkan
                    </button>
                }
            </div>
        </div>
    </div>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CustomerDto>? _customers;

    private Guid?   _customerId;
    private string? _customerName;
    private string  _servedBy = "";
    private bool    _isDeliveryRequired;

    private bool IsWalkIn => _customerId is null;

    // Scan / search
    private string  _codeInput   = "";
    private string? _scanMessage;
    private ElementReference _codeInputRef;
    private IJSObjectReference? _scanner;

    private List<ProductSearchDto> _suggestions = [];
    private bool _showSuggestions;
    private int  _highlightIndex = -1;
    private int  _searchGeneration;

    private readonly List<CartLine> _lines = [];

    private decimal _discount;
    private bool    _taxEnabled;

    private string? _error;
    private bool    _processing;

    // ── Computed totals ──────────────────────────────────────────────────────
    private decimal Subtotal       => _lines.Sum(l => l.Total);
    private decimal DiscountAmount  => Math.Clamp(_discount, 0m, Subtotal);
    private decimal TaxAmount       => _taxEnabled ? Math.Round((Subtotal - DiscountAmount) * 0.11m, 0) : 0m;
    private decimal GrandTotal      => Subtotal - DiscountAmount + TaxAmount;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _servedBy = state.User.Identity?.Name ?? "";
        }

        // Products are not pre-loaded — autocomplete is served on demand from Redis.
        _customers = (await CustomerApi.GetCustomersAsync(isActive: true))?.Items ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _scanner = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-scanner.js");
        await FocusCodeAsync();
    }

    // ── Header handlers ──────────────────────────────────────────────────────
    private void OnCustomerChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _customerId         = null;
            _customerName       = null;
            _isDeliveryRequired = false;   // walk-in / Umum cannot request delivery
            return;
        }

        var customer = _customers?.FirstOrDefault(c => c.Id == id);
        _customerId   = customer?.Id;
        _customerName = customer?.Name;
    }

    // ── Search / autocomplete ─────────────────────────────────────────────────
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _codeInput   = e.Value?.ToString() ?? "";
        _scanMessage = null;

        // "Latest wins" debounce without cancelling in-flight HTTP requests — that
        // would abort the socket and raise a TaskCanceledException on every keystroke.
        var generation = ++_searchGeneration;

        var term = _codeInput.Trim();
        if (term.Length == 0)
        {
            _suggestions     = [];
            _showSuggestions = false;
            return;
        }

        await Task.Delay(200);                          // debounce keystrokes
        if (generation != _searchGeneration) return;    // a newer keystroke superseded this

        List<ProductSearchDto> results;
        try
        {
            results = await InventoryApi.SearchProductsAsync(term, 8);
        }
        catch (HttpRequestException)
        {
            return;   // transient lookup failure — leave current suggestions untouched
        }

        if (generation != _searchGeneration) return;    // discard stale response

        _suggestions     = results;
        _showSuggestions = results.Count > 0;
        _highlightIndex  = -1;
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") { Move(1);  return; }
        if (e.Key == "ArrowUp")   { Move(-1); return; }
        if (e.Key == "Escape")    { _showSuggestions = false; _highlightIndex = -1; return; }
        if (e.Key != "Enter")     return;

        await AddFromInputAsync();
    }

    private void Move(int delta)
    {
        if (_suggestions.Count == 0) return;
        _showSuggestions = true;
        _highlightIndex  = Math.Clamp(_highlightIndex + delta, 0, _suggestions.Count - 1);
    }

    private async Task ScanAsync()
    {
        if (_scanner is null) return;

        var code = await _scanner.InvokeAsync<string>("startScan");
        if (string.IsNullOrWhiteSpace(code)) return;

        _codeInput = code;
        await AddFromInputAsync();
    }

    /// <summary>Resolves the current input (highlighted suggestion, exact match, or Redis lookup).</summary>
    private async Task AddFromInputAsync()
    {
        if (_highlightIndex >= 0 && _highlightIndex < _suggestions.Count)
        {
            await SelectSuggestionAsync(_suggestions[_highlightIndex]);
            return;
        }

        var term = _codeInput.Trim();
        if (term.Length == 0) return;

        var exact = _suggestions.FirstOrDefault(p =>
            p.Sku.Equals(term, StringComparison.OrdinalIgnoreCase) ||
            p.Name.Equals(term, StringComparison.OrdinalIgnoreCase));
        if (exact is not null) { await SelectSuggestionAsync(exact); return; }

        var results = await InventoryApi.SearchProductsAsync(term, 5);
        var match = results.FirstOrDefault(p => p.Sku.Equals(term, StringComparison.OrdinalIgnoreCase))
                 ?? (results.Count == 1 ? results[0] : null);

        if (match is not null) { await SelectSuggestionAsync(match); return; }

        _scanMessage     = $"Produk \"{term}\" tidak ditemukan.";
        _suggestions     = results;
        _showSuggestions = results.Count > 0;
    }

    private async Task SelectSuggestionAsync(ProductSearchDto product)
    {
        AddOrIncrement(product);
        _codeInput       = "";
        _suggestions     = [];
        _showSuggestions = false;
        _highlightIndex  = -1;
        _scanMessage     = null;
        await FocusCodeAsync();
    }

    private void AddOrIncrement(ProductSearchDto product)
    {
        // Available sellable units (base first); fall back to base unit if none provided.
        var units = product.Units is { Count: > 0 }
            ? product.Units
            : [new ProductUnitPriceDto(product.BaseUnit, product.SalePrice)];
        var baseUnit = units[0];

        var existing = _lines.FirstOrDefault(l => l.ProductId == product.Id && l.UnitName == baseUnit.UnitName);
        if (existing is not null)
        {
            existing.Quantity += 1;
            return;
        }

        _lines.Add(new CartLine
        {
            ProductId   = product.Id,
            ProductName = product.Name,
            Sku         = product.Sku,
            UnitName    = baseUnit.UnitName,
            Quantity    = 1,
            UnitPrice   = baseUnit.SalePrice,   // auto-loaded for the unit; still editable in the table
            Units       = units,
        });
    }

    private void OnUnitChanged(CartLine line, ChangeEventArgs e)
    {
        var unitName = e.Value?.ToString();
        if (string.IsNullOrEmpty(unitName)) return;

        var unit = line.Units.FirstOrDefault(u => u.UnitName == unitName);
        if (unit is null) return;

        line.UnitName  = unit.UnitName;
        line.UnitPrice = unit.SalePrice;   // re-price for the chosen unit (still editable)
    }

    // ── Line editing (flat guard clauses) ────────────────────────────────────
    private void OnQtyChanged(CartLine line, ChangeEventArgs e)
    {
        if (!TryParse(e.Value, out var qty)) return;
        if (qty <= 0) { _lines.Remove(line); return; }
        line.Quantity = qty;
    }

    private void OnPriceChanged(CartLine line, ChangeEventArgs e)
    {
        if (!TryParse(e.Value, out var price)) return;
        if (price < 0) { line.UnitPrice = 0; return; }
        line.UnitPrice = price;
    }

    private void OnDiscountChanged(ChangeEventArgs e)
    {
        if (!TryParse(e.Value, out var value)) { _discount = 0; return; }
        _discount = value < 0 ? 0 : value;
    }

    // ── Finalize ─────────────────────────────────────────────────────────────
    private async Task FinalizeAsync()
    {
        if (_lines.Count == 0 || _processing) return;

        _processing = true;
        _error      = null;

        var items = _lines
            .Select(l => new FinalizeSaleItemInput(l.ProductId, l.ProductName, l.UnitName, l.Quantity, l.UnitPrice))
            .ToList();

        var (result, error) = await SaleApi.FinalizeAsync(
            _customerId, _customerName, items, _isDeliveryRequired);

        _processing = false;
        if (error is not null) { _error = error; return; }

        Navigation.NavigateTo($"/sales/{result!.SaleId}?finalized=1");
    }

    private async Task ClearAll()
    {
        _lines.Clear();
        _discount    = 0;
        _taxEnabled  = false;
        _scanMessage = null;
        _error       = null;
        await FocusCodeAsync();
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private async Task FocusCodeAsync()
    {
        if (_scanner is null) return;
        try { await _scanner.InvokeVoidAsync("focusInput", _codeInputRef); }
        catch { /* element not ready — ignore */ }
    }

    private static bool TryParse(object? value, out decimal result)
        => decimal.TryParse(value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out result);

    public async ValueTask DisposeAsync()
    {
        if (_scanner is null) return;
        try { await _scanner.DisposeAsync(); }
        catch { /* circuit already torn down */ }
    }

    private sealed class CartLine
    {
        public Guid    ProductId   { get; init; }
        public string  ProductName { get; init; } = "";
        public string  Sku         { get; init; } = "";
        public string  UnitName    { get; set; } = "";
        public decimal Quantity    { get; set; }
        public decimal UnitPrice   { get; set; }
        public IReadOnlyList<ProductUnitPriceDto> Units { get; init; } = [];
        public decimal Total       => Quantity * UnitPrice;
    }
}
