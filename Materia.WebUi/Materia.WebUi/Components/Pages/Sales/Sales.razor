@page "/sales"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject SaleApiClient Api
@inject StoreSettingsApiClient StoreApi
@inject CustomerApiClient CustomerApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Penjualan — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Penjualan</h4>
    <div class="d-flex gap-2">
        <a href="/pos" class="btn btn-success btn-sm">
            <i class="bi bi-shop me-1"></i> Kasir (PoS)
        </a>
        <a href="/sales/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Penjualan Baru
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">No. Referensi</label>
                <input type="text" class="form-control form-control-sm" style="width:160px"
                       placeholder="Cari no. referensi…"
                       @bind="_referenceNoFilter" @bind:after="ResetAndLoad" />
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">Pelanggan</label>
                <input type="text" class="form-control form-control-sm" style="width:180px"
                       placeholder="Cari pelanggan…"
                       @bind="_customerFilter" @bind:after="ResetAndLoad" />
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">Tipe</label>
                <select class="form-select form-select-sm" style="width:130px"
                        @bind="_typeFilter" @bind:after="ResetAndLoad">
                    <option value="">Semua Tipe</option>
                    <option value="Pickup">Ambil</option>
                    <option value="Delivery">Kirim</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">Status</label>
                <select class="form-select form-select-sm" style="width:160px"
                        @bind="_statusFilter" @bind:after="ResetAndLoad">
                    <option value="">Semua Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Confirmed">Dikonfirmasi</option>
                    <option value="Paid">Lunas</option>
                    <option value="PartiallyPaid">Piutang (Bon)</option>
                    <option value="Cancelled">Dibatalkan</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">Dari</label>
                <input type="date" class="form-control form-control-sm" style="width:150px"
                       @bind="_fromFilter" @bind:after="ResetAndLoad" />
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1 text-muted">Sampai</label>
                <input type="date" class="form-control form-control-sm" style="width:150px"
                       @bind="_toFilter" @bind:after="ResetAndLoad" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">
                    <i class="bi bi-x-circle me-1"></i> Reset
                </button>
            </div>
        </div>
    </div>
</div>

@if (_sales is null)
{
    <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Memuat…</div>
}
else if (_sales.Items.Count == 0)
{
    <div class="alert alert-info">Belum ada penjualan.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>No. Referensi</th>
                        <th>Pelanggan</th>
                        <th>Tipe</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th>Tanggal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _sales.Items)
                    {
                        <tr>
                            <td class="fw-semibold font-monospace">@s.ReferenceNo</td>
                            <td>@s.CustomerName</td>
                            <td>
                                @if (s.SaleType == SaleType.Delivery)
                                {
                                    <span class="badge text-bg-info">
                                        <i class="bi bi-truck me-1"></i> Kirim
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        <i class="bi bi-shop me-1"></i> Ambil
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-semibold">Rp @s.GrandTotal.ToString("N0")</td>
                            <td>@StatusBadge(s.Status)</td>
                            <td class="small text-muted">
                                @s.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td class="text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-1" title="Cetak"
                                        @onclick="() => RequestPrint(s)">
                                    <i class="bi bi-printer"></i>
                                </button>
                                <a href="/sales/@s.Id" class="btn btn-sm btn-outline-secondary" title="Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_sales.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, _sales.TotalCount))
                dari @_sales.TotalCount transaksi
            </small>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" disabled="@(_page <= 1)"
                        @onclick="() => ChangePage(_page - 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="btn btn-outline-secondary"
                        disabled="@(_page >= _sales.TotalPages)"
                        @onclick="() => ChangePage(_page + 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
}

@* Hidden print template — rendered for the row chosen via the print button. *@
@if (_printSale is not null)
{
    <SaleDocumentPrint Sale="_printSale" StoreProfile="_storeProfile" StoreLogo="_storeLogo"
                       CustomerPhone="_printPhone" CustomerAddress="_printAddress" />
}

@code {
    private PagedSalesDto? _sales;
    private string    _statusFilter    = "";
    private string    _customerFilter  = "";
    private string    _typeFilter      = "";
    private string    _referenceNoFilter = "";
    private DateTime? _fromFilter;
    private DateTime? _toFilter;
    private int       _page            = 1;
    private const int _pageSize        = 20;

    // ── Print ────────────────────────────────────────────────────────────────
    private SaleDto?         _printSale;
    private bool             _printPending;
    private StoreProfileDto? _storeProfile;
    private string?          _storeLogo;
    private string?          _printPhone;
    private string?          _printAddress;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Store profile/logo for the print header (optional — degrade gracefully).
        try
        {
            _storeProfile = await StoreApi.GetProfileAsync();
            if (_storeProfile?.HasLogo == true)
                _storeLogo = await StoreApi.GetLogoDataUrlAsync();
        }
        catch { /* print header is optional */ }
    }

    private async Task LoadAsync()
        => _sales = await Api.GetSalesAsync(
            _page, _pageSize,
            status:       string.IsNullOrEmpty(_statusFilter)   ? null : _statusFilter,
            customerName: string.IsNullOrEmpty(_customerFilter) ? null : _customerFilter,
            saleType:     string.IsNullOrEmpty(_typeFilter)     ? null : _typeFilter,
            referenceNo:  string.IsNullOrEmpty(_referenceNoFilter) ? null : _referenceNoFilter,
            from: _fromFilter,
            to:   _toFilter.HasValue ? _toFilter.Value.AddDays(1).AddSeconds(-1) : null);

    private async Task ResetAndLoad()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        _statusFilter      = "";
        _customerFilter    = "";
        _typeFilter        = "";
        _referenceNoFilter = "";
        _fromFilter        = null;
        _toFilter          = null;
        _page              = 1;
        await LoadAsync();
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    // The list rows already carry the full SaleDto. We only fetch the customer to
    // enrich the printed Surat Jalan with phone + address (SaleDto has neither).
    // Set the target, let it render into the hidden template, then trigger the
    // browser print dialog from OnAfterRenderAsync.
    private async Task RequestPrint(SaleDto sale)
    {
        _printPhone   = null;
        _printAddress = null;
        if (sale.CustomerId is { } customerId)
        {
            try
            {
                var customer = await CustomerApi.GetCustomerByIdAsync(customerId);
                (_printPhone, _printAddress) = SaleDocumentPrint.CustomerContact(customer);
            }
            catch { /* contact is optional for the print */ }
        }
        _printSale    = sale;
        _printPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_printPending || _printSale is null) return;
        _printPending = false;
        await JS.InvokeVoidAsync("printReceipt", SaleDocumentPrint.IsSuratJalanFor(_printSale));
    }

    private static MarkupString StatusBadge(SaleStatus status) => status switch
    {
        SaleStatus.Draft         => (MarkupString)"<span class='badge bg-warning text-dark'>Draft</span>",
        SaleStatus.Confirmed     => (MarkupString)"<span class='badge bg-primary'>Dikonfirmasi</span>",
        SaleStatus.Paid          => (MarkupString)"<span class='badge bg-success'>Lunas</span>",
        SaleStatus.PartiallyPaid => (MarkupString)"<span class='badge bg-warning text-dark'>Piutang (Bon)</span>",
        SaleStatus.Cancelled     => (MarkupString)"<span class='badge bg-danger'>Dibatalkan</span>",
        _                        => (MarkupString)"<span class='badge bg-secondary'>—</span>",
    };
}
