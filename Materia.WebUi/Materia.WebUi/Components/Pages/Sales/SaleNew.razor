@page "/sales/new"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject SaleApiClient    SaleApi
@inject InventoryApiClient InventoryApi
@inject CustomerApiClient  CustomerApi
@inject NavigationManager Navigation

<PageTitle>Penjualan Baru — Materia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/sales" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
    <h4 class="mb-0 fw-bold">Penjualan Baru</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </div>
}

<div class="row g-4">

    @* ── Left column: customer + items ── *@
    <div class="col-lg-7">

        @* Customer & Type *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-person me-1"></i> Pelanggan & Tipe
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small">Pelanggan</label>
                        <select class="form-select form-select-sm"
                                @onchange="OnCustomerChanged">
                            <option value="">— Umum —</option>
                            @if (_customers is not null)
                            {
                                @foreach (var c in _customers)
                                {
                                    <option value="@c.Id">@c.Name (@c.Phone)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Tipe Penjualan</label>
                        <select class="form-select form-select-sm"
                                @bind="_saleType">
                            <option value="Pickup">Ambil di Toko</option>
                            <option value="Delivery">Pengiriman</option>
                        </select>
                    </div>
                    @if (_saleType == "Delivery")
                    {
                        @if (_selectedCustomer is null)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 small mb-0">
                                    Pengiriman hanya tersedia untuk pelanggan terdaftar.
                                </div>
                            </div>
                        }
                        else if (_selectedCustomer.Addresses.Count == 0)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 small mb-0">
                                    Pelanggan belum memiliki alamat pengiriman.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <label class="form-label small">Alamat Pengiriman</label>
                                <select class="form-select form-select-sm"
                                        @onchange="OnAddressChanged">
                                    <option value="">— pilih alamat —</option>
                                    @foreach (var a in _selectedCustomer.Addresses)
                                    {
                                        <option value="@a.Id" selected="@a.IsDefault">
                                            @a.Label — @a.Street, @a.City
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* Add Item *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Tambah Item
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small">Produk</label>
                        <select class="form-select form-select-sm"
                                @onchange="OnProductChanged">
                            <option value="">— pilih produk —</option>
                            @if (_products is not null)
                            {
                                @foreach (var p in _products)
                                {
                                    <option value="@p.Id">@p.Name (@p.BaseUnit)</option>
                                }
                            }
                        </select>
                    </div>
                    @if (_selectedProduct is not null)
                    {
                        <div class="col-md-4">
                            <label class="form-label small">Satuan</label>
                            <select class="form-select form-select-sm" @bind="_itemUnitName">
                                <option value="@_selectedProduct.BaseUnit">
                                    @_selectedProduct.BaseUnit (satuan dasar)
                                </option>
                                @foreach (var conv in _selectedProduct.UnitConversions)
                                {
                                    <option value="@conv.ToUnit">@conv.ToUnit</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Kuantitas</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="_itemQty" min="0.001" step="0.001" placeholder="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Harga / Satuan (Rp)</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="_itemPrice" min="0" step="100" placeholder="0" />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-sm btn-primary"
                                    @onclick="AddItemToCart"
                                    disabled="@(_itemQty <= 0 || string.IsNullOrEmpty(_itemUnitName))">
                                <i class="bi bi-plus me-1"></i> Tambah
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Items cart *@
        @if (_cartItems.Count > 0)
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-cart me-1"></i> Item (@_cartItems.Count)
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Produk</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Harga</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _cartItems)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.ProductName</span>
                                        <span class="badge text-bg-light border ms-1 small">@item.UnitName</span>
                                    </td>
                                    <td class="text-center">@item.Quantity.ToString("G29")</td>
                                    <td class="text-end">Rp @item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end fw-semibold">Rp @(item.Quantity * item.UnitPrice).ToString("N0")</td>
                                    <td class="text-end">
                                        <button class="btn btn-xs btn-outline-danger"
                                                @onclick="() => _cartItems.Remove(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @* ── Right column: summary + payment ── *@
    <div class="col-lg-5">
        <div class="card sticky-top" style="top:1rem">
            <div class="card-header fw-semibold">
                <i class="bi bi-receipt me-1"></i> Ringkasan
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td class="text-muted">Subtotal</td>
                        <td class="text-end fw-semibold">Rp @Subtotal.ToString("N0")</td>
                    </tr>
                    <tr class="border-top">
                        <td class="fw-bold">Total</td>
                        <td class="text-end fw-bold fs-5">Rp @Subtotal.ToString("N0")</td>
                    </tr>
                </table>

                <hr />

                <div class="mb-3">
                    <label class="form-label">Metode Pembayaran</label>
                    <select class="form-select" @bind="_paymentMethod">
                        <option value="Cash">Tunai</option>
                        <option value="BankTransfer">Transfer Bank</option>
                        <option value="QRIS">QRIS</option>
                        <option value="Debit">Kartu Debit</option>
                        <option value="Credit">Kartu Kredit</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Jumlah Dibayar (Rp)</label>
                    <input type="number" class="form-control"
                           @bind="_paidAmount" min="0" step="1000" />
                    @if (_paidAmount > 0 && _paidAmount >= Subtotal)
                    {
                        <div class="mt-1 text-success small fw-semibold">
                            Kembalian: Rp @(_paidAmount - Subtotal).ToString("N0")
                        </div>
                    }
                    else if (_paidAmount > 0 && _paidAmount < Subtotal)
                    {
                        <div class="mt-1 text-danger small">
                            Kurang: Rp @(Subtotal - _paidAmount).ToString("N0")
                        </div>
                    }
                </div>

                <button class="btn btn-success w-100"
                        @onclick="HandleCheckout"
                        disabled="@(!CanCheckout || _processing)">
                    @if (_processing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>
                    }
                    Bayar Sekarang
                </button>

                @if (!CanCheckout)
                {
                    <div class="mt-2 text-muted small text-center">
                        @if (_cartItems.Count == 0)
                        {
                            <span>Tambahkan item terlebih dahulu</span>
                        }
                        else if (_paidAmount < Subtotal)
                        {
                            <span>Jumlah bayar tidak mencukupi</span>
                        }
                        else if (_saleType == "Delivery" && _selectedAddressId is null)
                        {
                            <span>Pilih alamat pengiriman</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    // ── State ──────────────────────────────────────────────────────────────────

    private List<CustomerDto>?  _customers;
    private List<ProductDto>?   _products;
    private CustomerDto?        _selectedCustomer;
    private ProductDto?         _selectedProduct;

    private string  _saleType          = "Pickup";
    private Guid?   _selectedAddressId;
    private string? _selectedAddressText;

    private string  _itemUnitName = "";
    private decimal _itemQty      = 0;
    private decimal _itemPrice    = 0;

    private readonly List<CartItem> _cartItems = [];

    private string  _paymentMethod = "Cash";
    private decimal _paidAmount    = 0;

    private string? _error;
    private bool    _processing;

    private decimal Subtotal    => _cartItems.Sum(i => i.Quantity * i.UnitPrice);
    private bool    CanCheckout =>
        _cartItems.Count > 0
        && _paidAmount >= Subtotal
        && (_saleType != "Delivery" || _selectedAddressId.HasValue);

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var customersTask = CustomerApi.GetCustomersAsync(isActive: true);
        var productsTask  = InventoryApi.GetProductsAsync(isActive: true);

        _customers = (await customersTask)?.Items ?? [];
        _products  = (await productsTask)?.Items ?? [];
    }

    // ── Event handlers ─────────────────────────────────────────────────────────

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        _selectedAddressId   = null;
        _selectedAddressText = null;

        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedCustomer = await CustomerApi.GetCustomerByIdAsync(id);
            // Auto-select default address if Delivery
            if (_saleType == "Delivery")
            {
                var def = _selectedCustomer?.Addresses.FirstOrDefault(a => a.IsDefault);
                if (def is not null)
                {
                    _selectedAddressId   = def.Id;
                    _selectedAddressText = $"{def.Street}, {def.City}";
                }
            }
        }
        else
        {
            _selectedCustomer = null;
            if (_saleType == "Delivery") _saleType = "Pickup";
        }
    }

    private void OnAddressChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id) && _selectedCustomer is not null)
        {
            var addr = _selectedCustomer.Addresses.FirstOrDefault(a => a.Id == id);
            _selectedAddressId   = addr?.Id;
            _selectedAddressText = addr is not null ? $"{addr.Street}, {addr.City}" : null;
        }
    }

    private async Task OnProductChanged(ChangeEventArgs e)
    {
        _selectedProduct = null;
        _itemUnitName    = "";
        _itemQty         = 0;
        _itemPrice       = 0;

        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedProduct = await InventoryApi.GetProductByIdAsync(id);
            if (_selectedProduct is not null)
                _itemUnitName = _selectedProduct.BaseUnit;
        }
    }

    private void AddItemToCart()
    {
        if (_selectedProduct is null || _itemQty <= 0) return;

        _cartItems.Add(new CartItem(
            _selectedProduct.Id,
            _selectedProduct.Name,
            _itemUnitName,
            _itemQty,
            _itemPrice));

        // Reset item form
        _selectedProduct = null;
        _itemUnitName    = "";
        _itemQty         = 0;
        _itemPrice       = 0;
    }

    private async Task HandleCheckout()
    {
        _processing = true;
        _error      = null;

        try
        {
            // 1. Create sale
            var (saleId, createError) = await SaleApi.CreateSaleAsync(
                _selectedCustomer?.Id,
                _selectedCustomer?.Name ?? "Umum",
                _saleType,
                _selectedAddressId,
                _selectedAddressText);

            if (createError is not null) { _error = createError; return; }

            // 2. Add items
            foreach (var item in _cartItems)
            {
                var (_, itemError) = await SaleApi.AddItemAsync(
                    saleId!.Value,
                    item.ProductId, item.ProductName,
                    item.UnitName, item.Quantity, item.UnitPrice);

                if (itemError is not null)
                {
                    _error = $"Gagal menambah item '{item.ProductName}': {itemError}";
                    return;
                }
            }

            // 3. Checkout
            var (sale, checkoutError) = await SaleApi.CheckoutAsync(
                saleId!.Value, _paidAmount, _paymentMethod);

            if (checkoutError is not null) { _error = checkoutError; return; }

            // Success — redirect to receipt
            Navigation.NavigateTo($"/sales/{saleId}?paid=1", forceLoad: true);
        }
        finally
        {
            _processing = false;
        }
    }

    // ── Cart item model ────────────────────────────────────────────────────────

    private sealed record CartItem(
        Guid    ProductId,
        string  ProductName,
        string  UnitName,
        decimal Quantity,
        decimal UnitPrice);
}
