@page "/units"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject InventoryApiClient Api

<PageTitle>Satuan — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Satuan</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(_notice))
{
    <div class="alert alert-success alert-dismissible">
        @_notice
        <button type="button" class="btn-close" @onclick="() => _notice = null"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        @if (_editingId is null)
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Satuan Baru
                </div>
                <div class="card-body">
                    <EditForm Model="_createForm" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nama <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_createForm.Name"
                                       placeholder="cth. kilogram, sak, batang" />
                            <ValidationMessage For="() => _createForm.Name" class="small text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Simbol</label>
                            <InputText class="form-control" @bind-Value="_createForm.Symbol"
                                       placeholder="cth. kg, pcs" />
                            <div class="form-text">Singkatan opsional untuk satuan ini.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                            }
                            Simpan
                        </button>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <div class="card border-warning">
                <div class="card-header fw-semibold text-warning-emphasis bg-warning-subtle d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-pencil me-1"></i> Ubah Satuan</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="card-body">
                    <EditForm Model="_editForm" OnValidSubmit="HandleEdit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nama <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editForm.Name" />
                            <ValidationMessage For="() => _editForm.Name" class="small text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Simbol</label>
                            <InputText class="form-control" @bind-Value="_editForm.Symbol" />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning flex-grow-1" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg me-1"></i>
                                }
                                Simpan Perubahan
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Batal</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">Semua Satuan</div>
            <div class="card-body p-0">
                @if (_units is null)
                {
                    <div class="p-3 text-muted">
                        <span class="spinner-border spinner-border-sm me-1"></span> Memuat…
                    </div>
                }
                else if (_units.Count == 0)
                {
                    <div class="p-3 text-muted">Belum ada satuan.</div>
                }
                else
                {
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nama</th>
                                <th>Simbol</th>
                                <th>Status</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in _units)
                            {
                                <tr class="@(_editingId == unit.Id ? "table-warning" : "")">
                                    <td class="fw-semibold">@unit.Name</td>
                                    <td class="text-muted">@(unit.Symbol ?? "—")</td>
                                    <td>
                                        @if (unit.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button class="btn btn-sm @(_editingId == unit.Id ? "btn-warning" : "btn-outline-secondary")"
                                                    title="Ubah" @onclick="() => StartEdit(unit)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (unit.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Nonaktifkan"
                                                        @onclick="() => HandleToggleStatus(unit)">
                                                    <i class="bi bi-toggle-on"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        title="Aktifkan"
                                                        @onclick="() => HandleToggleStatus(unit)">
                                                    <i class="bi bi-toggle-off"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<UnitDto>? _units;
    private Guid? _editingId;
    private string? _error;
    private string? _notice;
    private bool _saving;

    private UnitFormModel _createForm = new();
    private UnitFormModel _editForm   = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
        => _units = await Api.GetUnitsAsync() ?? [];

    private async Task HandleCreate()
    {
        _error  = null;
        _saving = true;
        var (_, error) = await Api.CreateUnitAsync(_createForm.Name, _createForm.Symbol);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _notice     = "Satuan berhasil dibuat.";
        _createForm = new();
        await LoadAsync();
    }

    private async Task HandleEdit()
    {
        if (_editingId is null) return;
        _error  = null;
        _saving = true;
        var error = await Api.UpdateUnitAsync(_editingId.Value, _editForm.Name, _editForm.Symbol);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _notice    = "Satuan berhasil diperbarui.";
        _editingId = null;
        _editForm  = new();
        await LoadAsync();
    }

    private async Task HandleToggleStatus(UnitDto unit)
    {
        _error = null;
        var error = await Api.SetUnitStatusAsync(unit.Id, !unit.IsActive);
        if (error is not null) { _error = error; return; }
        _notice = $"Satuan '{unit.Name}' berhasil {(unit.IsActive ? "dinonaktifkan" : "diaktifkan")}.";
        await LoadAsync();
    }

    private void StartEdit(UnitDto unit)
    {
        _editingId        = unit.Id;
        _editForm.Name    = unit.Name;
        _editForm.Symbol  = unit.Symbol;
        _error  = null;
        _notice = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editForm  = new();
        _error     = null;
    }

    private sealed class UnitFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama satuan wajib diisi.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(20)]
        public string? Symbol { get; set; }
    }
}
