@page "/products/new"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject InventoryApiClient Api
@inject SupplierApiClient  SupplierApi
@inject NavigationManager Navigation

<PageTitle>Produk Baru — Materia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/products" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
    <h4 class="mb-0 fw-bold">Produk Baru</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card" style="max-width:560px">
    <div class="card-body">
        <EditForm Model="_form" OnValidSubmit="HandleCreate">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nama Produk <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="_form.Name" placeholder="cth. Semen Padang" />
                <ValidationMessage For="() => _form.Name" class="small text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Deskripsi</label>
                <InputTextArea class="form-control" @bind-Value="_form.Description" rows="3" placeholder="Deskripsi opsional" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label">Harga Jual (Rp)</label>
                    <InputNumber class="form-control" @bind-Value="_form.SalePrice" min="1" step="any" />
                    <div class="form-text">Harga default saat produk dipilih di kasir.</div>
                    <ValidationMessage For="() => _form.SalePrice" class="small text-danger" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Barcode / QR</label>
                    <InputText class="form-control" @bind-Value="_form.Barcode" placeholder="cth. 8991234567890" />
                    <div class="form-text">Opsional, harus unik.</div>
                    <ValidationMessage For="() => _form.Barcode" class="small text-danger" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Satuan Dasar <span class="text-danger">*</span></label>
                @if (_units is null)
                {
                    <div class="text-muted small">Memuat satuan…</div>
                }
                else if (_units.Count == 0)
                {
                    <div class="alert alert-warning py-2 small">
                        Belum ada satuan aktif. <a href="/units">Buat satuan</a> terlebih dahulu.
                    </div>
                }
                else
                {
                    <InputSelect class="form-select" @bind-Value="_form.BaseUnit">
                        <option value="">— pilih satuan —</option>
                        @foreach (var unit in _units)
                        {
                            <option value="@unit.Name">
                                @unit.Name@(unit.Symbol is not null ? $" ({unit.Symbol})" : "")
                            </option>
                        }
                    </InputSelect>
                }
                <div class="form-text">Satuan ukur utama untuk produk ini.</div>
                <ValidationMessage For="() => _form.BaseUnit" class="small text-danger" />
            </div>

            <div class="mb-4">
                <label class="form-label">Kategori</label>
                @if (_categories is null)
                {
                    <div class="text-muted small">Memuat kategori…</div>
                }
                else if (_categories.Count == 0)
                {
                    <div class="text-muted small">Belum ada kategori tersedia.</div>
                }
                else
                {
                    <div class="border rounded p-2" style="max-height:180px;overflow-y:auto">
                        @foreach (var cat in _categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cat-@cat.Id"
                                       checked="@_selectedIds.Contains(cat.Id)"
                                       @onchange="e => ToggleCategory(cat.Id, (bool)e.Value!)" />
                                <label class="form-check-label" for="cat-@cat.Id">@cat.Name</label>
                            </div>
                        }
                    </div>
                    @if (_selectedIds.Count > 0)
                    {
                        <div class="mt-1 d-flex flex-wrap gap-1">
                            @foreach (var id in _selectedIds)
                            {
                                var name = _categories.FirstOrDefault(c => c.Id == id)?.Name ?? id.ToString();
                                <span class="badge text-bg-secondary">@name</span>
                            }
                        </div>
                    }
                }
            </div>

            @* ── Harga beli awal (opsional) ── *@
            <div class="mb-4 border rounded p-3 bg-light-subtle">
                <label class="form-label fw-semibold">
                    Harga Beli <span class="text-muted small fw-normal">(opsional)</span>
                </label>
                @if (_suppliers.Count == 0)
                {
                    <div class="text-muted small">
                        Belum ada pemasok aktif — harga beli bisa diatur nanti dari halaman produk.
                    </div>
                }
                else
                {
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small">Pemasok</label>
                            <select class="form-select form-select-sm" @bind="_buySupplierId">
                                <option value="@Guid.Empty">— pilih pemasok —</option>
                                @foreach (var s in _suppliers)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Harga list (Rp)</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="_buyList" @bind:event="oninput" min="0" step="100" placeholder="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">
                                Diskon bertingkat (%)
                                <i class="bi bi-info-circle text-muted" title="mis. 12,5+7+5"></i>
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="_buyDiscountText" @bind:event="oninput" placeholder="mis. 12,5+7+5" />
                        </div>
                    </div>
                    @if (_buyList > 0)
                    {
                        var disc = DiscountInput.Parse(_buyDiscountText);
                        <div class="small mt-2">
                            Harga beli nett@(disc.Count > 0 ? $" ({DiscountInput.Format(disc)})" : ""):
                            <span class="fw-semibold text-success">
                                Rp @DiscountInput.ComputeNet(_buyList, disc).ToString("N0")
                            </span>
                        </div>
                    }
                    <div class="form-text">Disimpan ke katalog pemasok terpilih. Bisa juga diatur nanti.</div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    <i class="bi bi-check-lg me-1"></i> Buat Produk
                </button>
                <a href="/products" class="btn btn-outline-secondary">Batal</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly CreateForm _form = new();
    private string? _error;
    private bool _saving;
    private List<CategoryDto>? _categories;
    private List<UnitDto>? _units;
    private readonly HashSet<Guid> _selectedIds = [];

    // Optional initial buy price (per-supplier catalog).
    private List<SupplierDto> _suppliers = [];
    private Guid    _buySupplierId;
    private decimal _buyList;
    private string  _buyDiscountText = "";
    private Guid?   _createdProductId;   // guards against re-creating on retry

    protected override async Task OnInitializedAsync()
    {
        var categoriesTask = Api.GetCategoriesAsync();
        var unitsTask = Api.GetUnitsAsync();
        var suppliersTask = SupplierApi.GetSuppliersAsync(activeOnly: true, pageSize: 500);

        _categories = (await categoriesTask)
            ?.Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToList() ?? [];

        _units = (await unitsTask)
            ?.Where(u => u.IsActive)
            .OrderBy(u => u.Name)
            .ToList() ?? [];

        _suppliers = (await suppliersTask)?.Items ?? [];
    }

    private void ToggleCategory(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
    }

    private async Task HandleCreate()
    {
        _saving = true;
        _error = null;

        // Create the product once; on a retry (e.g. buy-price failed) skip re-creating it.
        if (_createdProductId is null)
        {
            var (id, error) = await Api.CreateProductAsync(
                _form.Name, _form.Description, _form.BaseUnit,
                _selectedIds.Count > 0 ? [.. _selectedIds] : null,
                _form.SalePrice,
                string.IsNullOrWhiteSpace(_form.Barcode) ? null : _form.Barcode.Trim());
            if (error is not null) { _saving = false; _error = error; return; }
            _createdProductId = id;
        }

        // Optional initial buy price → supplier catalog (discount chain is a calculator; store net).
        if (_buySupplierId != Guid.Empty && _buyList > 0)
        {
            var net = DiscountInput.ComputeNet(_buyList, DiscountInput.Parse(_buyDiscountText));
            var priceErr = await SupplierApi.SetPriceAsync(
                _buySupplierId, _createdProductId!.Value, net, "IDR", _form.BaseUnit, DateTime.Today);
            if (priceErr is not null)
            {
                _saving = false;
                _error = $"Produk dibuat, tetapi harga beli gagal disimpan: {priceErr}. " +
                         "Coba simpan lagi, atau atur dari halaman produk.";
                return;
            }
        }

        _saving = false;
        Navigation.NavigateTo($"/products/{_createdProductId}?created=1", forceLoad: true);
    }

    private sealed class CreateForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama produk wajib diisi.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(1000)]
        public string? Description { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Satuan dasar wajib diisi.")]
        [System.ComponentModel.DataAnnotations.MaxLength(50)]
        public string BaseUnit { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0.01, double.MaxValue, ErrorMessage = "Harga jual harus lebih dari 0.")]
        public decimal SalePrice { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string? Barcode { get; set; }
    }
}
