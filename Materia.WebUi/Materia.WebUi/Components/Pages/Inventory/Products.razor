@page "/products"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Materia.WebUi.Services
@inject InventoryApiClient Api
@inject NavigationManager Navigation

<PageTitle>Produk — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Produk</h4>
    <a href="/products/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Produk Baru
    </a>
</div>

@if (!string.IsNullOrEmpty(_notice))
{
    <div class="alert alert-success">@_notice</div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="btn-group btn-group-sm" role="group">
            <a href="/products" class="btn @(_filter == null ? "btn-dark" : "btn-outline-secondary")">Semua</a>
            <a href="/products?active=true" class="btn @(_filter == true ? "btn-success" : "btn-outline-secondary")">Aktif</a>
            <a href="/products?active=false" class="btn @(_filter == false ? "btn-secondary" : "btn-outline-secondary")">Tidak Aktif</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (_products is null)
        {
            <div class="p-3 text-muted">Memuat…</div>
        }
        else if (_products.Items.Count == 0)
        {
            <div class="p-3 text-muted">Tidak ada produk ditemukan.</div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nama</th>
                        <th>Satuan Dasar</th>
                        <th class="text-end">Harga Jual</th>
                        <th>Barcode</th>
                        <th>Kategori</th>
                        <th>Warna</th>
                        <th>Status</th>
                        <th>Diperbarui</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _products.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Name</td>
                            <td><span class="badge bg-light text-dark border">@p.BaseUnit</span></td>
                            <td class="text-end">@(p.SalePrice > 0 ? $"Rp {p.SalePrice:N0}" : "—")</td>
                            <td class="small">
                                @(string.IsNullOrEmpty(p.Barcode)
                                    ? (MarkupString)"<span class='text-muted'>—</span>"
                                    : (MarkupString)$"<code>{p.Barcode}</code>")
                            </td>
                            <td class="small text-muted">
                                @(p.Categories.Count == 0 ? "—" : string.Join(", ", p.Categories.Select(c => c.Name)))
                            </td>
                            <td class="small">
                                @{
                                    var variantCount = p.ColorVariants?.Count ?? 0;
                                }
                                @if (variantCount > 0)
                                {
                                    <span class="badge bg-light text-dark border">@variantCount warna</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tidak Aktif</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @((p.UpdatedAt ?? p.CreatedAt).ToLocalTime().ToString("dd MMM yyyy"))
                            </td>
                            <td class="text-end">
                                <a href="/products/@p.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i>Kelola
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_products.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
                    <small class="text-muted">
                        Menampilkan @((_products.Page - 1) * _products.PageSize + 1)–@(Math.Min(_products.Page * _products.PageSize, _products.TotalCount)) dari @_products.TotalCount produk
                    </small>
                    <div class="btn-group btn-group-sm">
                        @if (_products.Page > 1)
                        {
                            <a href="@($"/products?page={_products.Page - 1}{FilterQuery}")" class="btn btn-outline-secondary">‹ Sebelumnya</a>
                        }
                        @if (_products.Page < _products.TotalPages)
                        {
                            <a href="@($"/products?page={_products.Page + 1}{FilterQuery}")" class="btn btn-outline-secondary">Berikutnya ›</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private PagedProductsDto? _products;
    private bool? _filter;
    private string? _notice;

    private string FilterQuery => _filter.HasValue ? $"&active={_filter.Value}" : "";

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        if (query.ContainsKey("created"))
            _notice = "Produk berhasil dibuat.";

        var activeParam = query.TryGetValue("active", out var av) ? av.ToString() : "";
        _filter = activeParam == "true" ? true : activeParam == "false" ? false : null;

        var page = query.TryGetValue("page", out var pv) && int.TryParse(pv, out var p) ? p : 1;
        _products = await Api.GetProductsAsync(page, 20, _filter);
    }
}
