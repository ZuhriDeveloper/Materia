@page "/products"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Materia.WebUi.Services
@inject InventoryApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Produk — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Produk</h4>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success btn-sm"
                @onclick="ExportExcel" disabled="@(_exporting || _loading)">
            @if (_exporting)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel me-1"></i>
            }
            Ekspor Excel
        </button>
        <a href="/products/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Produk Baru
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_notice))
{
    <div class="alert alert-success alert-dismissible">
        @_notice
        <button type="button" class="btn-close" @onclick="() => _notice = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(_exportError))
{
    <div class="alert alert-danger alert-dismissible">
        @_exportError
        <button type="button" class="btn-close" @onclick="() => _exportError = null"></button>
    </div>
}

@* ── Filter card ──────────────────────────────────────────────────────────────── *@
<div class="card mb-3">
    <div class="card-body pb-2">
        <div class="row g-2 align-items-end">

            @* Search text *@
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">
                    <i class="bi bi-search me-1"></i>Cari
                </label>
                <div class="input-group input-group-sm">
                    <input type="text"
                           class="form-control"
                           placeholder="Nama produk atau barcode…"
                           @bind="_searchInput"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown" />
                    @if (!string.IsNullOrEmpty(_searchInput))
                    {
                        <button class="btn btn-outline-secondary" type="button"
                                @onclick="ClearSearch" title="Hapus pencarian">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
                <div class="form-text">Tekan Enter atau klik Cari</div>
            </div>

            @* Category dropdown *@
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">
                    <i class="bi bi-tag me-1"></i>Kategori
                </label>
                <select class="form-select form-select-sm"
                        value="@_categoryFilter"
                        @onchange="OnCategoryChanged"
                        disabled="@(_categories.Count == 0)">
                    <option value="">Semua Kategori</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            @* Status toggle *@
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">
                    <i class="bi bi-toggle-on me-1"></i>Status
                </label>
                <div class="btn-group btn-group-sm d-flex" role="group">
                    <button type="button"
                            class="btn @(_statusFilter == null ? "btn-dark" : "btn-outline-secondary")"
                            @onclick='() => SetStatusFilter(null)'>
                        Semua
                    </button>
                    <button type="button"
                            class="btn @(_statusFilter == true ? "btn-success" : "btn-outline-secondary")"
                            @onclick='() => SetStatusFilter(true)'>
                        Aktif
                    </button>
                    <button type="button"
                            class="btn @(_statusFilter == false ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick='() => SetStatusFilter(false)'>
                        Nonaktif
                    </button>
                </div>
            </div>

            @* Search button *@
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-primary btn-sm" @onclick="ApplySearch"
                        disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                    }
                    Cari
                </button>
            </div>

        </div>

        @* Active-filter chips *@
        @if (HasActiveFilters)
        {
            <div class="d-flex flex-wrap gap-1 mt-2">
                @if (!string.IsNullOrEmpty(_appliedSearch))
                {
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle fw-normal">
                        <i class="bi bi-search me-1"></i>«@_appliedSearch»
                        <button type="button" class="btn-close btn-close-sm ms-1"
                                style="font-size:.6rem" @onclick="ClearSearch"></button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(_categoryFilter))
                {
                    var catName = _categories.FirstOrDefault(c => c.Id.ToString() == _categoryFilter)?.Name;
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal">
                        <i class="bi bi-tag me-1"></i>@catName
                        <button type="button" class="btn-close btn-close-sm ms-1"
                                style="font-size:.6rem" @onclick="ClearCategory"></button>
                    </span>
                }
                @if (_statusFilter.HasValue)
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border fw-normal">
                        @(_statusFilter.Value ? "Aktif" : "Nonaktif")
                        <button type="button" class="btn-close btn-close-sm ms-1"
                                style="font-size:.6rem" @onclick='() => SetStatusFilter(null)'></button>
                    </span>
                }
                <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1"
                        @onclick="ClearAllFilters">
                    Hapus semua
                </button>
            </div>
        }
    </div>
</div>

@* ── Results table ────────────────────────────────────────────────────────────── *@
<div class="card">
    <div class="card-body p-0">

        @if (_loading)
        {
            <div class="p-4 text-center text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Memuat…
            </div>
        }
        else if (_products is null || _products.Items.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                <p class="mb-1">Tidak ada produk ditemukan.</p>
                @if (HasActiveFilters)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-1"
                            @onclick="ClearAllFilters">
                        Hapus filter
                    </button>
                }
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nama</th>
                        <th>Satuan Dasar</th>
                        <th class="text-end">Stok</th>
                        <th class="text-end">Harga Beli</th>
                        <th class="text-end">Harga Jual</th>
                        <th>Barcode</th>
                        <th>Kategori</th>
                        <th>Status</th>
                        <th>Diperbarui</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _products.Items)
                    {
                        <tr class="@(p.NeedsAttention ? "table-warning" : null)">
                            <td class="fw-semibold">
                                @if (p.NeedsAttention)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"
                                       title="@AttentionReason(p)"></i>
                                }
                                @p.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@p.BaseUnit</span>
                            </td>
                            <td class="text-end @(p.HasStock ? "" : "text-danger fw-semibold")">
                                @if (p.HasStock)
                                {
                                    @($"{p.StockQuantity:0.##} {p.BaseUnit}")
                                }
                                else
                                {
                                    <span title="Stok habis / belum ada">0</span>
                                }
                            </td>
                            <td class="text-end">
                                @(p.HasPurchasePrice ? $"Rp {p.LatestPurchasePrice:N0}" : "—")
                            </td>
                            <td class="text-end">
                                @(p.SalePrice > 0 ? $"Rp {p.SalePrice:N0}" : "—")
                            </td>
                            <td class="small">
                                @if (string.IsNullOrEmpty(p.Barcode))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <code>@p.Barcode</code>
                                }
                            </td>
                            <td class="small text-muted">
                                @(p.Categories.Count == 0
                                    ? "—"
                                    : string.Join(", ", p.Categories.Select(c => c.Name)))
                            </td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tidak Aktif</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @((p.UpdatedAt ?? p.CreatedAt).ToLocalTime().ToString("dd MMM yyyy"))
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => OpenStockModal(p)" title="Atur stok">
                                    <i class="bi bi-box-seam me-1"></i>Stok
                                </button>
                                <a href="/products/@p.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i>Kelola
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* ── Pagination ── *@
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top flex-wrap gap-2">
                <small class="text-muted">
                    Menampilkan
                    <strong>@((_page - 1) * PageSize + 1)</strong>–<strong>@(Math.Min(_page * PageSize, _products.TotalCount))</strong>
                    dari <strong>@_products.TotalCount</strong> produk
                    @{
                        var attentionCount = _products.Items.Count(p => p.NeedsAttention);
                    }
                    @if (attentionCount > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-normal ms-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @attentionCount perlu perhatian
                        </span>
                    }
                </small>

                @if (_products.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @* Prev *@
                            <li class="page-item @(_page <= 1 ? "disabled" : "")">
                                <button type="button" class="page-link"
                                        disabled="@(_page <= 1 || _loading)"
                                        @onclick="() => SetPage(_page - 1)">
                                    ‹
                                </button>
                            </li>

                            @* Page numbers — show window of 5 around current *@
                            @{
                                var start = Math.Max(1, _page - 2);
                                var end   = Math.Min(_products.TotalPages, _page + 2);
                            }
                            @if (start > 1)
                            {
                                <li class="page-item">
                                    <button type="button" class="page-link" @onclick="() => SetPage(1)">1</button>
                                </li>
                                @if (start > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">…</span>
                                    </li>
                                }
                            }
                            @for (int i = start; i <= end; i++)
                            {
                                var pg = i;
                                <li class="page-item @(pg == _page ? "active" : "")">
                                    <button type="button" class="page-link"
                                            disabled="@_loading"
                                            @onclick="() => SetPage(pg)">@pg</button>
                                </li>
                            }
                            @if (end < _products.TotalPages)
                            {
                                @if (end < _products.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">…</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <button type="button" class="page-link"
                                            @onclick="() => SetPage(_products.TotalPages)">
                                        @_products.TotalPages
                                    </button>
                                </li>
                            }

                            @* Next *@
                            <li class="page-item @(_page >= _products.TotalPages ? "disabled" : "")">
                                <button type="button" class="page-link"
                                        disabled="@(_page >= _products.TotalPages || _loading)"
                                        @onclick="() => SetPage(_page + 1)">
                                    ›
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }

    </div>
</div>

@* ── Quick stock-edit modal ───────────────────────────────────────────────────── *@
@if (_stockModalOpen && _stockProduct is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Atur Stok</h5>
                    <button type="button" class="btn-close"
                            @onclick="CloseStockModal" disabled="@_stockSaving"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-semibold">@_stockProduct.Name</p>

                    @if (!string.IsNullOrEmpty(_stockError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@_stockError</div>
                    }

                    @if (_stockLoading)
                    {
                        <div class="text-center text-muted py-3">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            Memuat stok per warna…
                        </div>
                    }
                    else if (_variantStockRows is not null)
                    {
                        @* ── Per-color editor (products with color variants) ── *@
                        <p class="small text-muted mb-2">
                            Masukkan jumlah fisik di gudang untuk tiap warna — sistem mencatat selisihnya.
                        </p>
                        <div class="table-responsive mb-2">
                            <table class="table table-sm align-middle mb-1">
                                <thead class="table-light">
                                    <tr>
                                        <th>Warna</th>
                                        <th class="text-end">Stok saat ini</th>
                                        <th style="width:9rem">Jumlah baru</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _variantStockRows)
                                    {
                                        <tr class="@(row.IsActive ? "" : "opacity-50")">
                                            <td class="fw-semibold">
                                                @if (IsHexColor(row.ColorCode))
                                                {
                                                    <span class="d-inline-block rounded-circle border align-middle me-2"
                                                          style="width:14px;height:14px;background-color:@row.ColorCode"></span>
                                                }
                                                @row.Label
                                                @if (!row.IsActive)
                                                {
                                                    <span class="badge bg-secondary ms-1">Nonaktif</span>
                                                }
                                            </td>
                                            <td class="text-end text-muted">@($"{row.CurrentQty:0.##}")</td>
                                            <td>
                                                <input type="number" step="any" min="0"
                                                       class="form-control form-control-sm text-end"
                                                       @bind="row.NewQty" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-text mb-3">Satuan: @_stockProduct.BaseUnit</div>
                    }
                    else
                    {
                        @* ── Single-bucket editor (products without color variants) ── *@
                        <p class="small text-muted mb-3">
                            Stok saat ini:
                            <strong>@($"{_stockProduct.StockQuantity:0.##} {_stockProduct.BaseUnit}")</strong>
                        </p>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Jumlah stok baru</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" min="0" class="form-control"
                                       @bind="_stockNewQty" />
                                <span class="input-group-text">@_stockProduct.BaseUnit</span>
                            </div>
                            <div class="form-text">
                                Masukkan jumlah fisik di gudang — sistem mencatat selisihnya.
                            </div>
                        </div>
                    }

                    @if (!_stockLoading)
                    {
                        <div class="mb-1">
                            <label class="form-label small text-muted mb-1">Alasan (opsional)</label>
                            <input type="text" class="form-control form-control-sm" maxlength="500"
                                   placeholder="mis. stok awal, hasil opname…" @bind="_stockReason" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="CloseStockModal" disabled="@_stockSaving">
                        Batal
                    </button>
                    <button type="button" class="btn btn-sm btn-primary"
                            @onclick="SaveStock" disabled="@(_stockSaving || _stockLoading)">
                        @if (_stockSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    // ── Constants ──────────────────────────────────────────────────────────────
    private const int PageSize = 20;

    // ── State ─────────────────────────────────────────────────────────────────
    private PagedProductsDto?  _products;
    private List<CategoryDto>  _categories = [];
    private bool               _loading    = true;
    private bool               _exporting;
    private string?            _notice;
    private string?            _exportError;
    private int                _page       = 1;

    // Filter state: _searchInput is the live text; _appliedSearch is what was last searched.
    private string  _searchInput    = "";
    private string  _appliedSearch  = "";  // tracks last committed search term
    private string  _categoryFilter = "";  // empty = all categories
    private bool?   _statusFilter;         // null = all statuses

    // Quick stock-edit modal state (no supplier/PO needed). Products without color variants
    // adjust the single product-level bucket via _stockNewQty; products with variants adjust
    // one bucket per color via _variantStockRows.
    private bool        _stockModalOpen;
    private ProductDto? _stockProduct;
    private decimal     _stockNewQty;
    private string?     _stockReason;
    private string?     _stockError;
    private bool        _stockSaving;
    private bool        _stockLoading;
    private List<VariantStockRow>? _variantStockRows;

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_appliedSearch) ||
        !string.IsNullOrEmpty(_categoryFilter) ||
        _statusFilter.HasValue;

    // ── Init ──────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.ContainsKey("created"))
            _notice = "Produk berhasil dibuat.";

        // Load categories and first page of products in parallel.
        var catsTask = Api.GetCategoriesAsync();
        await LoadAsync();
        _categories = (await catsTask)?
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToList() ?? [];
    }

    // ── Data loading ──────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        Guid? catId = Guid.TryParse(_categoryFilter, out var g) ? g : null;
        string? searchArg = string.IsNullOrWhiteSpace(_appliedSearch) ? null : _appliedSearch.Trim();

        _products = await Api.GetProductsAsync(
            page: _page, pageSize: PageSize,
            isActive: _statusFilter,
            search: searchArg,
            categoryId: catId);

        _loading = false;
    }

    // ── Excel export ──────────────────────────────────────────────────────────
    /// Exports every product matching the active filters (no paging) to an .xlsx download.
    private async Task ExportExcel()
    {
        _exporting = true;
        _exportError = null;
        StateHasChanged();

        try
        {
            Guid? catId = Guid.TryParse(_categoryFilter, out var g) ? g : null;
            string? searchArg = string.IsNullOrWhiteSpace(_appliedSearch) ? null : _appliedSearch.Trim();

            var result = await Api.ExportProductsAsync(
                isActive: _statusFilter, search: searchArg, categoryId: catId);

            if (result is null)
            {
                _exportError = "Gagal mengekspor produk. Silakan coba lagi.";
                return;
            }

            using var stream = new MemoryStream(result.Value.Content);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", result.Value.FileName, streamRef);
        }
        catch (Exception)
        {
            _exportError = "Gagal mengekspor produk. Silakan coba lagi.";
        }
        finally
        {
            _exporting = false;
        }
    }

    // ── Filter handlers ───────────────────────────────────────────────────────

    /// Commits the typed search and reloads from page 1.
    private async Task ApplySearch()
    {
        _appliedSearch = _searchInput;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearch();
    }

    private async Task ClearSearch()
    {
        _searchInput   = "";
        _appliedSearch = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        _categoryFilter = e.Value?.ToString() ?? "";
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearCategory()
    {
        _categoryFilter = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task SetStatusFilter(bool? value)
    {
        _statusFilter = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearAllFilters()
    {
        _searchInput    = "";
        _appliedSearch  = "";
        _categoryFilter = "";
        _statusFilter   = null;
        _page = 1;
        await LoadAsync();
    }

    // ── Paging ────────────────────────────────────────────────────────────────
    private async Task SetPage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    // ── Quick stock edit ────────────────────────────────────────────────────────
    /// Opens the modal. For a product with color variants it loads one editable bucket per
    /// color; otherwise it pre-fills the single product-level stock field.
    private async Task OpenStockModal(ProductDto p)
    {
        _stockProduct     = p;
        _stockNewQty      = p.StockQuantity;
        _stockReason      = null;
        _stockError       = null;
        _variantStockRows = null;
        _stockModalOpen   = true;

        if (HasVariants(p))
        {
            _stockLoading = true;
            StateHasChanged();

            var stocks = await Api.GetProductStocksAsync(p.Id);
            _variantStockRows = BuildVariantStockRows(p, stocks);
            _stockLoading = false;
        }
    }

    private void CloseStockModal()
    {
        _stockModalOpen   = false;
        _stockProduct     = null;
        _variantStockRows = null;
    }

    private static bool HasVariants(ProductDto p) => p.ColorVariants is { Count: > 0 };

    /// Builds an editable row per color variant, plus the product-level ("umum") bucket when it
    /// still holds stock — matching each color to its current on-hand quantity (0 when no record).
    private static List<VariantStockRow> BuildVariantStockRows(ProductDto p, List<StockDto> stocks)
    {
        decimal QtyFor(Guid? variantId) =>
            stocks.FirstOrDefault(s => s.VariantId == variantId)?.Quantity ?? 0m;

        var rows = (p.ColorVariants ?? [])
            .Select(v =>
            {
                var qty = QtyFor(v.Id);
                return new VariantStockRow
                {
                    VariantId  = v.Id,
                    Label      = v.ColorName,
                    ColorCode  = v.ColorCode,
                    IsActive   = v.IsActive,
                    CurrentQty = qty,
                    NewQty     = qty,
                };
            })
            .ToList();

        // Surface the product-level bucket only when it carries stock, so leftover "no-color"
        // quantity stays manageable without cluttering the common per-color case.
        var umum = QtyFor(null);
        if (umum > 0m)
        {
            rows.Add(new VariantStockRow
            {
                VariantId  = null,
                Label      = "Umum (tanpa warna)",
                CurrentQty = umum,
                NewQty     = umum,
            });
        }

        return rows;
    }

    /// Records the difference between the entered count and the current stock as a manual
    /// adjustment — no supplier or purchase order required (auto-initialises stock if absent).
    private async Task SaveStock()
    {
        if (_stockProduct is null) return;

        _stockError = null;

        if (_variantStockRows is not null)
        {
            await SaveVariantStock();
            return;
        }

        if (_stockNewQty < 0)
        {
            _stockError = "Jumlah stok tidak boleh negatif.";
            return;
        }

        var delta = _stockNewQty - _stockProduct.StockQuantity;
        if (delta == 0)
        {
            _stockError = "Jumlah stok tidak berubah.";
            return;
        }

        _stockSaving = true;
        StateHasChanged();

        var reason = string.IsNullOrWhiteSpace(_stockReason)
            ? (_stockProduct.StockQuantity == 0 ? "Stok awal" : "Penyesuaian stok manual")
            : _stockReason!.Trim();

        var error = await Api.AdjustStockAsync(_stockProduct.Id, delta, reason);
        _stockSaving = false;

        if (error is not null)
        {
            _stockError = error;
            return;
        }

        var name = _stockProduct.Name;
        _stockModalOpen = false;
        _stockProduct   = null;
        _notice = $"Stok \"{name}\" berhasil diperbarui.";
        await LoadAsync();   // refresh the Stok column and the "perlu perhatian" flag
    }

    /// Applies a per-color adjustment for each row whose entered quantity changed. Each color is
    /// a separate stock bucket, so adjustments are recorded one event per changed color.
    private async Task SaveVariantStock()
    {
        var rows = _variantStockRows!;

        if (rows.Any(r => r.NewQty < 0))
        {
            _stockError = "Jumlah stok tidak boleh negatif.";
            return;
        }

        var changed = rows.Where(r => r.NewQty != r.CurrentQty).ToList();
        if (changed.Count == 0)
        {
            _stockError = "Jumlah stok tidak berubah.";
            return;
        }

        _stockSaving = true;
        StateHasChanged();

        var userReason = string.IsNullOrWhiteSpace(_stockReason) ? null : _stockReason!.Trim();
        var errors = new List<string>();

        foreach (var r in changed)
        {
            var delta  = r.NewQty - r.CurrentQty;
            var reason = userReason ?? (r.CurrentQty == 0 ? "Stok awal" : "Penyesuaian stok manual");
            var error  = await Api.AdjustStockAsync(_stockProduct!.Id, delta, reason, r.VariantId);
            if (error is not null)
                errors.Add($"{r.Label}: {error}");
        }

        _stockSaving = false;

        if (errors.Count > 0)
        {
            // Some colors may have saved; reload buckets so the form reflects reality.
            _stockError = string.Join(" ", errors);
            var stocks = await Api.GetProductStocksAsync(_stockProduct!.Id);
            _variantStockRows = BuildVariantStockRows(_stockProduct, stocks);
            return;
        }

        var name = _stockProduct!.Name;
        _stockModalOpen   = false;
        _stockProduct     = null;
        _variantStockRows = null;
        _notice = $"Stok \"{name}\" berhasil diperbarui.";
        await LoadAsync();
    }

    /// True when the code looks like a CSS hex color (#rgb or #rrggbb) so a swatch can be shown.
    private static bool IsHexColor(string? code) =>
        !string.IsNullOrWhiteSpace(code) &&
        System.Text.RegularExpressions.Regex.IsMatch(code, "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$");

    // ── Attention marker ────────────────────────────────────────────────────────
    /// Human-readable list of the master-data gaps that make a product need attention.
    private static string AttentionReason(ProductDto p)
    {
        var missing = new List<string>();
        if (!p.HasSupplier)      missing.Add("supplier");
        if (!p.HasStock)         missing.Add("stok");
        if (!p.HasPurchasePrice) missing.Add("harga beli");
        if (!p.HasSalePrice)     missing.Add("harga jual");
        return missing.Count == 0 ? "" : "Belum ada: " + string.Join(", ", missing);
    }

    /// One editable stock bucket in the per-color stock modal. <see cref="VariantId"/> is null for
    /// the product-level ("umum") bucket and set for a specific color variant.
    private sealed class VariantStockRow
    {
        public Guid?   VariantId  { get; init; }
        public string  Label      { get; init; } = "";
        public string? ColorCode  { get; init; }
        public bool    IsActive   { get; init; } = true;
        public decimal CurrentQty { get; init; }
        public decimal NewQty     { get; set; }
    }
}
