@page "/products/{id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Materia.WebUi.Services
@inject InventoryApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_product?.Name ?? "Produk") — Materia</PageTitle>

@if (_product is null)
{
    <div class="text-muted">Memuat…</div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="/products" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <h4 class="mb-0 fw-bold">@_product.Name</h4>
        @if (_product.IsActive)
        {
            <span class="badge bg-success">Aktif</span>
        }
        else
        {
            <span class="badge bg-secondary">Tidak Aktif</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert alert-success mb-3">@_notice</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mb-3">@_error</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Informasi Dasar</span>
                    <small class="text-muted">Satuan dasar: <strong>@_product.BaseUnit</strong></small>
                </div>
                <div class="card-body">
                    <EditForm Model="_editForm" OnValidSubmit="HandleEdit" FormName="edit-info" method="post">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nama Produk <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editForm.Name" />
                            <ValidationMessage For="() => _editForm.Name" class="small text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Deskripsi</label>
                            <InputTextArea class="form-control" @bind-Value="_editForm.Description" rows="3" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label">Harga Jual (Rp)</label>
                                <InputNumber class="form-control" @bind-Value="_editForm.SalePrice" min="0" step="100" />
                                <ValidationMessage For="() => _editForm.SalePrice" class="small text-danger" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Barcode / QR</label>
                                <InputText class="form-control" @bind-Value="_editForm.Barcode" placeholder="cth. 8991234567890" />
                                <ValidationMessage For="() => _editForm.Barcode" class="small text-danger" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
                        </button>
                    </EditForm>
                </div>
                <div class="card-footer">
                    <small class="text-muted d-block">
                        Dibuat oleh <strong>@_product.CreatedBy</strong>
                        pada @_product.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </small>
                    @if (_product.UpdatedBy is not null)
                    {
                        <small class="text-muted d-block mt-1">
                            Diperbarui oleh <strong>@_product.UpdatedBy</strong>
                            pada @_product.UpdatedAt!.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </small>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header fw-semibold">Status Produk</div>
                <div class="card-body d-flex align-items-center gap-3">
                    <p class="mb-0 text-muted small flex-grow-1">
                        @(_product.IsActive
                            ? "Produk ini aktif dan tersedia dalam sistem."
                            : "Produk ini tidak aktif dan disembunyikan dari operasional.")
                    </p>
                    <EditForm Model="_statusForm" OnValidSubmit="HandleToggleStatus" FormName="toggle-status" method="post">
                        @if (_product.IsActive)
                        {
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-toggle-off me-1"></i> Nonaktifkan
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-toggle-on me-1"></i> Aktifkan
                            </button>
                        }
                    </EditForm>
                </div>
            </div>

            <div class="card flex-grow-1">
                <div class="card-header fw-semibold">Kategori</div>
                <div class="card-body">
                    @if (_product.Categories.Count == 0)
                    {
                        <p class="text-muted small">Belum ada kategori yang ditetapkan.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var cat in _product.Categories)
                            {
                                <div class="d-inline-flex align-items-center gap-1">
                                    <span class="badge bg-primary fs-6 fw-normal px-2">@cat.Name</span>
                                    <EditForm Model="@(new RemoveCatForm { CategoryId = cat.Id })"
                                              OnValidSubmit="@(() => HandleRemoveCategory(cat.Id))"
                                              FormName="@($"remove-cat-{cat.Id}")"
                                              method="post">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1" title="Hapus kategori">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </EditForm>
                                </div>
                            }
                        </div>
                    }

                    @if (_availableCategories.Count > 0)
                    {
                        <EditForm Model="_assignCatForm" OnValidSubmit="HandleAssignCategory" FormName="assign-category" method="post">
                            <div class="input-group input-group-sm">
                                <InputSelect class="form-select" @bind-Value="_assignCatForm.CategoryId">
                                    <option value="">— pilih kategori —</option>
                                    @foreach (var cat in _availableCategories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                                <button type="submit" class="btn btn-outline-primary" disabled="@(_assignCatForm.CategoryId == Guid.Empty)">
                                    <i class="bi bi-plus-lg me-1"></i> Tambah
                                </button>
                            </div>
                        </EditForm>
                    }
                    else if (_product.Categories.Count > 0)
                    {
                        <p class="text-muted small mb-0">Semua kategori sudah ditetapkan.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Stok</div>
                <div class="card-body">
                    @if (_stock is null)
                    {
                        <p class="text-muted small">Belum ada data stok.</p>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="fs-3 fw-bold">@_stock.Quantity.ToString("G29")</span>
                            <span class="text-muted">@_stock.Unit</span>
                        </div>

                        @if (_product.UnitConversions.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var conv in _product.UnitConversions)
                                {
                                    var converted = _stock.Quantity * conv.Factor;
                                    <span class="badge text-bg-light border fs-6 fw-normal">
                                        @converted.ToString("G29") @conv.ToUnit
                                    </span>
                                }
                            </div>
                        }

                        @if (_stock.LastAdjustedAt.HasValue)
                        {
                            <p class="text-muted small mb-3">
                                Terakhir disesuaikan: @_stock.LastAdjustedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                oleh @_stock.LastAdjustedBy
                            </p>
                        }
                    }

                    <hr class="my-2" />
                    <p class="fw-semibold mb-2">Sesuaikan Stok</p>
                    @if (!string.IsNullOrEmpty(_stockError))
                    {
                        <div class="alert alert-danger py-2 small">@_stockError</div>
                    }
                    <EditForm Model="_stockForm" OnValidSubmit="HandleAdjustStock"
                              FormName="adjust-stock" method="post">
                        <DataAnnotationsValidator />
                        <div class="d-flex align-items-start gap-2" style="max-width:440px">
                            <div class="flex-grow-1">
                                <InputNumber class="form-control form-control-sm" @bind-Value="_stockForm.Delta"
                                             placeholder="cth. 10 atau -5" />
                                <ValidationMessage For="() => _stockForm.Delta" class="small text-danger" />
                            </div>
                            <div class="flex-grow-1">
                                <InputText class="form-control form-control-sm" @bind-Value="_stockForm.Reason"
                                           placeholder="Alasan (opsional)" />
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-repeat me-1"></i> Sesuaikan
                            </button>
                        </div>
                        <div class="form-text">Masukkan nilai positif untuk menambah, negatif untuk mengurangi.</div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Konversi Satuan</div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Tentukan berapa banyak satuan lain yang setara dengan 1 <strong>@_product.BaseUnit</strong>.
                        Contoh: 1 sak = 5 bungkus.
                    </p>

                    @if (_product.UnitConversions.Count > 0)
                    {
                        <table class="table table-sm table-bordered mb-3" style="max-width:560px">
                            <thead class="table-light">
                                <tr>
                                    <th>1 @_product.BaseUnit =</th>
                                    <th>Satuan</th>
                                    <th class="text-end">Harga Jual</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light">
                                    <td class="fw-semibold">1</td>
                                    <td>@_product.BaseUnit <span class="badge text-bg-secondary ms-1">dasar</span></td>
                                    <td class="text-end">@(_product.SalePrice > 0 ? $"Rp {_product.SalePrice:N0}" : "—")</td>
                                    <td></td>
                                </tr>
                                @foreach (var conv in _product.UnitConversions)
                                {
                                    <tr>
                                        <td class="fw-semibold">@conv.Factor</td>
                                        <td>@conv.ToUnit</td>
                                        <td class="text-end">@(conv.SalePrice > 0 ? $"Rp {conv.SalePrice:N0}" : "—")</td>
                                        <td class="text-end">
                                            <EditForm Model="@(new RemoveConvForm { ToUnit = conv.ToUnit })"
                                                      OnValidSubmit="@(() => HandleRemoveConversion(conv.ToUnit))"
                                                      FormName="@($"remove-conv-{conv.ToUnit}")"
                                                      method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i> Hapus
                                                </button>
                                            </EditForm>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <EditForm Model="_addConvForm" OnValidSubmit="HandleAddConversion" FormName="add-conversion" method="post">
                        <DataAnnotationsValidator />
                        <div class="d-flex align-items-start gap-2" style="max-width:480px">
                            <div class="flex-grow-1">
                                @if (_availableConvUnits.Count > 0)
                                {
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_addConvForm.ToUnit">
                                        <option value="">— pilih satuan —</option>
                                        @foreach (var u in _availableConvUnits)
                                        {
                                            <option value="@u.Name">
                                                @u.Name@(u.Symbol is not null ? $" ({u.Symbol})" : "")
                                            </option>
                                        }
                                    </InputSelect>
                                }
                                else
                                {
                                    <InputText class="form-control form-control-sm" @bind-Value="_addConvForm.ToUnit" placeholder="Nama satuan (cth. bungkus)" />
                                }
                                <ValidationMessage For="() => _addConvForm.ToUnit" class="small text-danger" />
                            </div>
                            <div style="width:110px">
                                <InputNumber class="form-control form-control-sm" @bind-Value="_addConvForm.Factor" placeholder="Faktor" />
                                <ValidationMessage For="() => _addConvForm.Factor" class="small text-danger" />
                            </div>
                            <div style="width:140px">
                                <InputNumber class="form-control form-control-sm" @bind-Value="_addConvForm.SalePrice" placeholder="Harga jual" />
                                <ValidationMessage For="() => _addConvForm.SalePrice" class="small text-danger" />
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Tambah
                            </button>
                        </div>
                        <div class="form-text">1 @_product.BaseUnit = [faktor] [satuan] · harga jual per [satuan]</div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Variasi Warna</span>
                    <span class="badge bg-light text-dark border">@Variants.Count varian</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Setiap warna adalah SKU tersendiri (barcode &amp; stok sendiri). Kosongkan
                        <em>harga khusus</em> untuk memakai harga produk
                        (@(_product.SalePrice > 0 ? $"Rp {_product.SalePrice:N0}" : "belum diatur")).
                    </p>

                    @if (!string.IsNullOrEmpty(_variantError))
                    {
                        <div class="alert alert-danger py-2 small">@_variantError</div>
                    }

                    @if (Variants.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-3">
                                <thead class="table-light">
                                    <tr>
                                        <th>Warna</th>
                                        <th>Kode</th>
                                        <th>Barcode</th>
                                        <th class="text-end">Harga</th>
                                        <th>Status</th>
                                        <th class="text-end" style="width:1%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Variants)
                                    {
                                        @if (_editingVariantId == v.Id)
                                        {
                                            <tr class="table-warning">
                                                <td><input class="form-control form-control-sm" @bind="_editVariantForm.ColorName" placeholder="Nama warna" /></td>
                                                <td><input class="form-control form-control-sm" @bind="_editVariantForm.ColorCode" placeholder="cth. #C0392B" /></td>
                                                <td><input class="form-control form-control-sm" @bind="_editVariantForm.Barcode" placeholder="Barcode" /></td>
                                                <td><input type="number" class="form-control form-control-sm text-end" @bind="_editVariantForm.PriceOverride" placeholder="Harga produk" /></td>
                                                <td class="text-muted small">—</td>
                                                <td class="text-end text-nowrap">
                                                    <button class="btn btn-sm btn-primary" title="Simpan" @onclick="HandleUpdateVariant" disabled="@_variantBusy">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" title="Batal" @onclick="CancelEditVariant" disabled="@_variantBusy">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr class="@(v.IsActive ? "" : "opacity-50")">
                                                <td class="fw-semibold">
                                                    @if (IsHexColor(v.ColorCode))
                                                    {
                                                        <span class="d-inline-block rounded-circle border align-middle me-2"
                                                              style="width:14px;height:14px;background-color:@v.ColorCode"></span>
                                                    }
                                                    @v.ColorName
                                                </td>
                                                <td class="small">@(string.IsNullOrEmpty(v.ColorCode) ? "—" : v.ColorCode)</td>
                                                <td class="small">
                                                    @if (string.IsNullOrEmpty(v.Barcode))
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    else
                                                    {
                                                        <code>@v.Barcode</code>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @(v.EffectivePrice > 0 ? $"Rp {v.EffectivePrice:N0}" : "—")
                                                    @if (v.PriceOverride.HasValue)
                                                    {
                                                        <span class="badge bg-info-subtle text-info-emphasis border ms-1">khusus</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (v.IsActive)
                                                    {
                                                        <span class="badge bg-success">Aktif</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Nonaktif</span>
                                                    }
                                                </td>
                                                <td class="text-end text-nowrap">
                                                    <button class="btn btn-sm btn-outline-secondary" title="Ubah"
                                                            @onclick="@(() => BeginEditVariant(v))" disabled="@_variantBusy">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm @(v.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                            title="@(v.IsActive ? "Nonaktifkan" : "Aktifkan")"
                                                            @onclick="@(() => HandleToggleVariantStatus(v))" disabled="@_variantBusy">
                                                        <i class="bi @(v.IsActive ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" title="Hapus"
                                                            @onclick="@(() => HandleRemoveVariant(v.Id))" disabled="@_variantBusy">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">Belum ada variasi warna. Tambahkan di bawah.</p>
                    }

                    <hr class="my-2" />
                    <p class="fw-semibold mb-2">Tambah Variasi Warna</p>
                    <EditForm Model="_addVariantForm" OnValidSubmit="HandleAddVariant" FormName="add-variant" method="post">
                        <DataAnnotationsValidator />
                        <div class="row g-2 align-items-start" style="max-width:780px">
                            <div class="col-sm-3">
                                <InputText class="form-control form-control-sm" @bind-Value="_addVariantForm.ColorName" placeholder="Nama warna *" />
                                <ValidationMessage For="() => _addVariantForm.ColorName" class="small text-danger" />
                            </div>
                            <div class="col-sm-3">
                                <InputText class="form-control form-control-sm" @bind-Value="_addVariantForm.ColorCode" placeholder="Kode (cth. #C0392B)" />
                                <ValidationMessage For="() => _addVariantForm.ColorCode" class="small text-danger" />
                            </div>
                            <div class="col-sm-3">
                                <InputText class="form-control form-control-sm" @bind-Value="_addVariantForm.Barcode" placeholder="Barcode (opsional)" />
                                <ValidationMessage For="() => _addVariantForm.Barcode" class="small text-danger" />
                            </div>
                            <div class="col-sm-2">
                                <InputNumber class="form-control form-control-sm" @bind-Value="_addVariantForm.PriceOverride" placeholder="Harga khusus" />
                                <ValidationMessage For="() => _addVariantForm.PriceOverride" class="small text-danger" />
                            </div>
                            <div class="col-sm-1 d-grid">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Tambah" disabled="@_variantBusy">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-text">Harga khusus opsional — kosongkan untuk memakai harga produk.</div>
                    </EditForm>
                </div>
            </div>
        </div>

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "edit-info")]
    private EditInfoForm _editForm { get; set; } = new();

    [SupplyParameterFromForm(FormName = "add-conversion")]
    private AddConvForm _addConvForm { get; set; } = new();

    [SupplyParameterFromForm(FormName = "assign-category")]
    private AssignCatForm _assignCatForm { get; set; } = new();

    private readonly StatusForm _statusForm = new();

    [SupplyParameterFromForm(FormName = "adjust-stock")]
    private StockAdjustForm _stockForm { get; set; } = new();

    [SupplyParameterFromForm(FormName = "add-variant")]
    private AddVariantForm _addVariantForm { get; set; } = new();

    protected override void OnParametersSet() { }

    private ProductDto? _product;
    private StockDto? _stock;
    private List<CategoryDto> _availableCategories = [];
    private List<UnitDto> _availableConvUnits = [];
    private string? _error;
    private string? _stockError;
    private string? _notice;

    private string? _variantError;
    private bool _variantBusy;
    private Guid? _editingVariantId;
    private VariantEditForm _editVariantForm = new();
    private IReadOnlyList<ColorVariantDto> Variants => _product?.ColorVariants ?? [];

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.ContainsKey("created"))
            _notice = "Produk berhasil dibuat.";

        await LoadAsync();

        // In Interactive Server the initial render is never a POST submission,
        // so the edit form is always pre-filled from the loaded product.
        if (_product is not null)
        {
            _editForm.Name = _product.Name;
            _editForm.Description = _product.Description;
            _editForm.SalePrice = _product.SalePrice;
            _editForm.Barcode = _product.Barcode;
        }
    }

    private async Task LoadAsync()
    {
        _product = await Api.GetProductByIdAsync(Id);
        if (_product is null) { Navigation.NavigateTo("/products"); return; }

        var allCats = await Api.GetCategoriesAsync() ?? [];
        var assignedIds = _product.Categories.Select(c => c.Id).ToHashSet();
        _availableCategories = allCats.Where(c => c.IsActive && !assignedIds.Contains(c.Id)).ToList();

        _stock = await Api.GetStockByProductIdAsync(Id);

        // Units available for new conversions: active units, excluding the base unit
        // and any unit already used in an existing conversion
        var alreadyUsed = _product.UnitConversions.Select(c => c.ToUnit).ToHashSet();
        alreadyUsed.Add(_product.BaseUnit);
        var allUnits = await Api.GetUnitsAsync() ?? [];
        _availableConvUnits = allUnits
            .Where(u => u.IsActive && !alreadyUsed.Contains(u.Name))
            .OrderBy(u => u.Name)
            .ToList();
    }

    private async Task HandleEdit()
    {
        _error = await Api.UpdateProductAsync(
            Id, _editForm.Name, _editForm.Description,
            _editForm.SalePrice,
            string.IsNullOrWhiteSpace(_editForm.Barcode) ? null : _editForm.Barcode.Trim());
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleToggleStatus()
    {
        _error = await Api.SetProductStatusAsync(Id, !_product!.IsActive);
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleAssignCategory()
    {
        if (_assignCatForm.CategoryId == Guid.Empty) return;
        _error = await Api.AssignCategoryAsync(Id, _assignCatForm.CategoryId);
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleRemoveCategory(Guid categoryId)
    {
        _error = await Api.RemoveCategoryAsync(Id, categoryId);
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleAddConversion()
    {
        _error = await Api.AddUnitConversionAsync(Id, _addConvForm.ToUnit, _addConvForm.Factor, _addConvForm.SalePrice);
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleRemoveConversion(string toUnit)
    {
        _error = await Api.RemoveUnitConversionAsync(Id, toUnit);
        if (_error is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
    }

    private async Task HandleAdjustStock()
    {
        _stockError = null;
        _stockError = await Api.AdjustStockAsync(Id, _stockForm.Delta, _stockForm.Reason);
        if (_stockError is null)
        {
            _stockForm = new();
            Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
        }
    }

    // ── Color Variants ──────────────────────────────────────────────────────────

    private async Task HandleAddVariant()
    {
        _variantError = null;
        _variantBusy = true;
        var (_, err) = await Api.AddColorVariantAsync(
            Id,
            _addVariantForm.ColorName.Trim(),
            Clean(_addVariantForm.ColorCode),
            Clean(_addVariantForm.Barcode),
            _addVariantForm.PriceOverride);
        _variantBusy = false;

        if (err is null)
        {
            _addVariantForm = new();
            Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
        }
        else { _variantError = err; }
    }

    private void BeginEditVariant(ColorVariantDto v)
    {
        _variantError = null;
        _editingVariantId = v.Id;
        _editVariantForm = new VariantEditForm
        {
            ColorName = v.ColorName,
            ColorCode = v.ColorCode,
            Barcode = v.Barcode,
            PriceOverride = v.PriceOverride,
        };
    }

    private void CancelEditVariant()
    {
        _editingVariantId = null;
        _variantError = null;
    }

    private async Task HandleUpdateVariant()
    {
        if (_editingVariantId is null) return;
        if (string.IsNullOrWhiteSpace(_editVariantForm.ColorName))
        {
            _variantError = "Nama warna wajib diisi.";
            return;
        }

        _variantError = null;
        _variantBusy = true;
        var err = await Api.UpdateColorVariantAsync(
            Id, _editingVariantId.Value,
            _editVariantForm.ColorName.Trim(),
            Clean(_editVariantForm.ColorCode),
            Clean(_editVariantForm.Barcode),
            _editVariantForm.PriceOverride);
        _variantBusy = false;

        if (err is null)
        {
            _editingVariantId = null;
            Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
        }
        else { _variantError = err; }
    }

    private async Task HandleToggleVariantStatus(ColorVariantDto v)
    {
        _variantError = null;
        _variantBusy = true;
        var err = await Api.SetColorVariantStatusAsync(Id, v.Id, !v.IsActive);
        _variantBusy = false;

        if (err is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
        else _variantError = err;
    }

    private async Task HandleRemoveVariant(Guid variantId)
    {
        _variantError = null;
        _variantBusy = true;
        var err = await Api.RemoveColorVariantAsync(Id, variantId);
        _variantBusy = false;

        if (err is null) Navigation.NavigateTo($"/products/{Id}", forceLoad: true);
        else _variantError = err;
    }

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static bool IsHexColor(string? code) =>
        !string.IsNullOrWhiteSpace(code) &&
        System.Text.RegularExpressions.Regex.IsMatch(code, "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$");

