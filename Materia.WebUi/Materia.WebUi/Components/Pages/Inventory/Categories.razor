@page "/categories"
@attribute [Authorize(Roles = "Admin,Gudang")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject InventoryApiClient Api

<PageTitle>Kategori — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Kategori</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(_notice))
{
    <div class="alert alert-success alert-dismissible">
        @_notice
        <button type="button" class="btn-close" @onclick="() => _notice = null"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        @if (_editingId is null)
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Kategori Baru
                </div>
                <div class="card-body">
                    <EditForm Model="_createForm" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nama <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_createForm.Name"
                                       placeholder="cth. Bahan Bangunan" />
                            <ValidationMessage For="() => _createForm.Name" class="small text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Deskripsi</label>
                            <InputTextArea class="form-control" @bind-Value="_createForm.Description"
                                          rows="2" placeholder="Deskripsi opsional" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                            }
                            Simpan
                        </button>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <div class="card border-warning">
                <div class="card-header fw-semibold text-warning-emphasis bg-warning-subtle d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-pencil me-1"></i> Ubah Kategori</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="card-body">
                    <EditForm Model="_editForm" OnValidSubmit="HandleEdit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nama <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editForm.Name" />
                            <ValidationMessage For="() => _editForm.Name" class="small text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Deskripsi</label>
                            <InputTextArea class="form-control" @bind-Value="_editForm.Description" rows="2" />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning flex-grow-1" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg me-1"></i>
                                }
                                Simpan Perubahan
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                Batal
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">Semua Kategori</div>
            <div class="card-body p-0">
                @if (_categories is null)
                {
                    <div class="p-3 text-muted">
                        <span class="spinner-border spinner-border-sm me-1"></span> Memuat…
                    </div>
                }
                else if (_categories.Count == 0)
                {
                    <div class="p-3 text-muted">Belum ada kategori.</div>
                }
                else
                {
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nama</th>
                                <th>Deskripsi</th>
                                <th>Diperbarui Oleh</th>
                                <th>Status</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in _categories)
                            {
                                <tr class="@(_editingId == cat.Id ? "table-warning" : "")">
                                    <td class="fw-semibold">@cat.Name</td>
                                    <td class="text-muted small">@(cat.Description ?? "—")</td>
                                    <td class="small text-muted">
                                        @if (cat.UpdatedBy is not null)
                                        {
                                            <span>@cat.UpdatedBy</span><br />
                                            <span style="font-size:.75rem">
                                                @cat.UpdatedAt!.Value.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@cat.CreatedBy</span><br />
                                            <span style="font-size:.75rem">
                                                @cat.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button class="btn btn-sm @(_editingId == cat.Id ? "btn-warning" : "btn-outline-secondary")"
                                                    title="Ubah" @onclick="() => StartEdit(cat)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (cat.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Nonaktifkan"
                                                        @onclick="() => HandleToggleStatus(cat)">
                                                    <i class="bi bi-toggle-on"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        title="Aktifkan"
                                                        @onclick="() => HandleToggleStatus(cat)">
                                                    <i class="bi bi-toggle-off"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────────

    private List<CategoryDto>? _categories;
    private Guid? _editingId;
    private string? _error;
    private string? _notice;
    private bool _saving;

    private CategoryFormModel _createForm = new();
    private CategoryFormModel _editForm   = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _categories = await Api.GetCategoriesAsync() ?? [];
    }

    // ── Handlers ──────────────────────────────────────────────────────────────

    private async Task HandleCreate()
    {
        _error  = null;
        _saving = true;

        var (_, error) = await Api.CreateCategoryAsync(_createForm.Name, _createForm.Description);

        _saving = false;

        if (error is not null) { _error = error; return; }

        _notice     = "Kategori berhasil dibuat.";
        _createForm = new();
        await LoadAsync();
    }

    private async Task HandleEdit()
    {
        if (_editingId is null) return;

        _error  = null;
        _saving = true;

        var error = await Api.UpdateCategoryAsync(_editingId.Value, _editForm.Name, _editForm.Description);

        _saving = false;

        if (error is not null) { _error = error; return; }

        _notice    = "Kategori berhasil diperbarui.";
        _editingId = null;
        _editForm  = new();
        await LoadAsync();
    }

    private async Task HandleToggleStatus(CategoryDto cat)
    {
        _error = null;

        var error = await Api.SetCategoryStatusAsync(cat.Id, !cat.IsActive);

        if (error is not null) { _error = error; return; }

        _notice = $"Kategori '{cat.Name}' berhasil {(cat.IsActive ? "dinonaktifkan" : "diaktifkan")}.";
        await LoadAsync();
    }

    private void StartEdit(CategoryDto cat)
    {
        _editingId         = cat.Id;
        _editForm.Name        = cat.Name;
        _editForm.Description = cat.Description;
        _error  = null;
        _notice = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editForm  = new();
        _error     = null;
    }

    // ── Form model ─────────────────────────────────────────────────────────────

    private sealed class CategoryFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama wajib diisi.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(500)]
        public string? Description { get; set; }
    }
}
