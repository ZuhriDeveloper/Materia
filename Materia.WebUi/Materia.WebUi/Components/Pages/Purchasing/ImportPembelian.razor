@page "/import-pembelian"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@using Microsoft.AspNetCore.Components.Forms
@inject PurchaseOrderApiClient PoApi
@inject NavigationManager Navigation

<PageTitle>Import Pembelian — Materia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/purchase-orders" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
    <h4 class="mb-0 fw-bold">Import Pembelian</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </div>
}

@* ── Step 1: Upload ── *@
@if (_result is null)
{
    <div class="card" style="max-width:560px">
        <div class="card-header fw-semibold">
            <i class="bi bi-cloud-upload me-1"></i> Upload Gambar Invoice
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Unggah foto atau scan invoice pembelian. AI akan membaca dan mengekstrak
                data order secara otomatis.
            </p>

            <InputFile OnChange="OnFileSelected"
                       accept="image/*,.pdf"
                       class="form-control mb-3" />

            @if (_selectedFile is not null)
            {
                <div class="d-flex align-items-center gap-2 mb-3 small text-muted">
                    <i class="bi bi-file-earmark-image"></i>
                    <span>@_selectedFile.Name</span>
                    <span>(@(_selectedFile.Size / 1024) KB)</span>
                </div>
            }

            <button class="btn btn-primary"
                    @onclick="HandleScan"
                    disabled="@(_selectedFile is null || _scanning)">
                @if (_scanning)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Memindai invoice...</span>
                }
                else
                {
                    <i class="bi bi-magic me-1"></i>
                    <span>Pindai dengan AI</span>
                }
            </button>
        </div>
    </div>
}

@* ── Step 2: Result ── *@
@if (_result is not null)
{
    <div class="mb-3">
        <div class="card mb-3" style="max-width:640px">
            <div class="card-body py-2 px-3 d-flex align-items-center gap-3">
                <div>
                    <span class="text-muted small me-2">Pemasok:</span>
                    <span class="fw-semibold">@(_result.SupplierName ?? "—")</span>
                </div>
                @if (!_result.SupplierFound)
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Pemasok tidak ditemukan di database
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Pemasok ditemukan
                    </span>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">
                <i class="bi bi-list-check me-1"></i> Hasil Pindai (@_result.Lines.Count item)
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Produk</th>
                            <th class="text-center">Qty</th>
                            <th>Satuan</th>
                            <th class="text-end">Harga Satuan</th>
                            <th class="text-end">Subtotal</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _result.Lines)
                        {
                            <tr class="@(line.ProductFound ? "" : "table-warning")">
                                <td class="fw-semibold">@line.ProductName</td>
                                <td class="text-center">@line.Quantity.ToString("G29")</td>
                                <td>@line.Unit</td>
                                <td class="text-end">Rp @line.UnitPrice.ToString("N0")</td>
                                <td class="text-end">Rp @((line.Quantity * line.UnitPrice).ToString("N0"))</td>
                                <td>
                                    @if (line.ProductFound)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Tidak ditemukan
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total Estimasi</td>
                            <td class="text-end fw-bold">
                                Rp @(_result.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N0"))
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (!_result.SupplierFound || _result.Lines.Any(l => !l.ProductFound))
        {
            <div class="alert alert-warning mt-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Beberapa pemasok atau produk tidak ditemukan di database. Pastikan data sudah
                terdaftar sebelum membuat order.
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-outline-secondary"
                    @onclick="() => { _result = null; _selectedFile = null; }">
                <i class="bi bi-arrow-repeat me-1"></i> Pindai Ulang
            </button>
            <button class="btn btn-success"
                    @onclick="HandleConfirm"
                    disabled="@(!_result.SupplierFound || _result.Lines.All(l => !l.ProductFound))">
                <i class="bi bi-check-circle me-1"></i> Buat Order Pembelian
            </button>
        </div>
    </div>
}

@code {
    private IBrowserFile?       _selectedFile;
    private ScannedInvoiceDto?  _result;
    private bool                _scanning;
    private string?             _error;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _result       = null;
        _error        = null;
    }

    private async Task HandleScan()
    {
        if (_selectedFile is null) return;

        _scanning = true;
        _error    = null;

        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var (result, error) = await PoApi.ScanInvoiceAsync(stream, _selectedFile.Name);

            if (error is not null) { _error = error; }
            else { _result = result; }
        }
        catch (Exception ex)
        {
            _error = $"Gagal memindai invoice: {ex.Message}";
        }
        finally
        {
            _scanning = false;
        }
    }

    private void HandleConfirm()
    {
        if (_result?.MatchedSupplierId is null) return;

        var lines = _result.Lines
            .Where(l => l.ProductFound && l.MatchedProductId is not null)
            .Select(l => $"{l.MatchedProductId}:{l.Quantity}")
            .ToArray();

        var query = string.Join("&", lines.Select(l => $"line={Uri.EscapeDataString(l)}"));
        Navigation.NavigateTo($"/purchase-orders/new?supplierId={_result.MatchedSupplierId}&{query}");
    }
}
