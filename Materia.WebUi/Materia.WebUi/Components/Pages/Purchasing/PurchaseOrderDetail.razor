@page "/purchase-orders/{id:guid}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject PurchaseOrderApiClient PoApi
@inject InventoryApiClient      InventoryApi
@inject NavigationManager       Navigation

<PageTitle>Order Pembelian — Materia</PageTitle>

@if (_po is null)
{
    <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Memuat…</div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="/purchase-orders" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <h4 class="mb-0 fw-bold">Order — @_po.SupplierName</h4>
        @StatusBadge(_po.Status)
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert alert-success alert-dismissible">
            @_notice
            <button type="button" class="btn-close" @onclick="() => _notice = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    <div class="row g-4">

        @* ── Lines ── *@
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Item Order</span>
                    @if (_receiving)
                    {
                        <span class="badge text-bg-primary">Mode Penerimaan</span>
                    }
                    @if (_returning)
                    {
                        <span class="badge text-bg-danger">Mode Retur / Koreksi</span>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Produk</th>
                                <th class="text-end">Dipesan</th>
                                <th class="text-end">Diterima</th>
                                <th class="text-end">Harga</th>
                                <th class="text-end">Subtotal</th>
                                @if (_receiving)
                                {
                                    <th class="text-end" style="width:140px">Terima Qty</th>
                                }
                                @if (_returning)
                                {
                                    <th class="text-end" style="width:140px">Retur Qty</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _po.Lines)
                            {
                                var remaining = line.OrderedQty - line.ReceivedQty;
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@ProductName(line.ProductId)</span>
                                        <span class="badge text-bg-light border ms-1 small">@line.Unit</span>
                                    </td>
                                    <td class="text-end">@line.OrderedQty.ToString("G29")</td>
                                    <td class="text-end">
                                        @line.ReceivedQty.ToString("G29")
                                        @if (line.ReturnedQty > 0)
                                        {
                                            <div class="small text-danger">
                                                − retur @line.ReturnedQty.ToString("G29")
                                                (net @line.NetReceivedQty.ToString("G29"))
                                            </div>
                                        }
                                        else if (remaining > 0 && line.ReceivedQty > 0)
                                        {
                                            <span class="text-muted small">(sisa @remaining.ToString("G29"))</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        Rp @line.UnitCost.ToString("N0")
                                        @if (line.HasDiscount)
                                        {
                                            <div class="small text-muted">
                                                <s>Rp @line.ListUnitCost.ToString("N0")</s>
                                                <span class="badge text-bg-light border ms-1">@DiscountInput.Format(line.Discounts)</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">
                                        Rp @((line.OrderedQty * line.UnitCost).ToString("N0"))
                                    </td>
                                    @if (_receiving)
                                    {
                                        <td class="text-end">
                                            @if (remaining > 0)
                                            {
                                                <input type="number" class="form-control form-control-sm text-end"
                                                       @bind="_receiptQty[line.ProductId]"
                                                       min="0" max="@remaining" step="0.001" />
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Lengkap</span>
                                            }
                                        </td>
                                    }
                                    @if (_returning)
                                    {
                                        <td class="text-end">
                                            @if (line.NetReceivedQty > 0)
                                            {
                                                <input type="number" class="form-control form-control-sm text-end"
                                                       @bind="_returnQty[line.ProductId]"
                                                       min="0" max="@line.NetReceivedQty" step="0.001" />
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total</td>
                                <td class="text-end fw-bold">Rp @Total.ToString("N0")</td>
                                @if (_receiving || _returning) { <td></td> }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (_receiving)
                {
                    <div class="card-footer d-flex gap-2 justify-content-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelReceive" disabled="@_saving">
                            Batal
                        </button>
                        <button class="btn btn-sm btn-success" @onclick="HandleReceive"
                                disabled="@(_saving || !HasReceiptQty)">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Konfirmasi Penerimaan
                        </button>
                    </div>
                }

                @if (_returning)
                {
                    <div class="card-footer">
                        <label class="form-label small">Alasan retur <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_returnReason"
                                  placeholder="cth. barang rusak / pecah saat diterima"></textarea>
                        <div class="d-flex gap-2 justify-content-between align-items-center flex-wrap">
                            <button class="btn btn-sm btn-outline-danger" @onclick="FillFullReturn" disabled="@_saving">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Retur Penuh (Void)
                            </button>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelReturn" disabled="@_saving">
                                    Batal
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="HandleReturn"
                                        disabled="@(_saving || !HasReturnQty || string.IsNullOrWhiteSpace(_returnReason))">
                                    <i class="bi bi-box-arrow-up me-1"></i> Konfirmasi Retur
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_receiving)
            {
                <div class="alert alert-info small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Saat penerimaan dikonfirmasi, saldo stok tiap produk akan bertambah (merekonsiliasi
                    stok negatif) dan harga beli dari order ini dicatat sebagai lapisan biaya historis.
                </div>
            }

            @if (_returning)
            {
                <div class="alert alert-warning small mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Gunakan ini untuk barang rusak yang dikembalikan ke pemasok. Saat retur dikonfirmasi,
                    stok produk akan berkurang dan nilai terutang ke pemasok ikut berkurang. Gunakan
                    <span class="fw-semibold">Retur Penuh (Void)</span> untuk membatalkan seluruh penerimaan.
                </div>
            }
        </div>

        @* ── Info & actions ── *@
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header fw-semibold">Informasi</div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted fw-normal">Pemasok</dt>
                        <dd class="col-7 fw-semibold">@_po.SupplierName</dd>

                        <dt class="col-5 text-muted fw-normal">Status</dt>
                        <dd class="col-7">@StatusBadge(_po.Status)</dd>

                        <dt class="col-5 text-muted fw-normal">Dibuat</dt>
                        <dd class="col-7">@_po.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

                        <dt class="col-5 text-muted fw-normal">Oleh</dt>
                        <dd class="col-7">@_po.CreatedBy</dd>

                        @if (_po.ReceivedAt.HasValue)
                        {
                            <dt class="col-5 text-muted fw-normal">@(_po.Status == "Closed" ? "Ditutup" : "Diterima")</dt>
                            <dd class="col-7">@_po.ReceivedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                        }

                        <dt class="col-5 text-muted fw-normal">Termin</dt>
                        <dd class="col-7">@TermDisplay()</dd>

                        @if (_po.PaymentTermValue.HasValue)
                        {
                            <dt class="col-5 text-muted fw-normal">Jatuh tempo</dt>
                            <dd class="col-7">
                                @if (_po.DueDate.HasValue)
                                {
                                    <span class="fw-semibold">@_po.DueDate.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">~@EstimatedDueDate().ToString("dd MMM yyyy") (estimasi)</span>
                                }
                            </dd>
                        }

                        @if (NetOwed > 0 || _po.Lines.Any(l => l.ReturnedQty > 0))
                        {
                            <dt class="col-5 text-muted fw-normal">Nilai terutang</dt>
                            <dd class="col-7 fw-semibold">Rp @NetOwed.ToString("N0")</dd>
                        }
                    </dl>
                </div>

                @if (!_receiving && !_returning && (CanAct || CanReturn))
                {
                    <div class="card-footer d-grid gap-2">
                        @if (_po.Status == "Draft")
                        {
                            <button class="btn btn-sm btn-primary" @onclick="HandleConfirm" disabled="@_saving">
                                <i class="bi bi-check2-circle me-1"></i> Konfirmasi Order
                            </button>
                        }
                        @if (_po.Status is "Confirmed" or "PartiallyReceived")
                        {
                            <button class="btn btn-sm btn-success" @onclick="StartReceive" disabled="@_saving">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Terima Barang
                            </button>
                        }
                        @if (CanReturn)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="StartReturn" disabled="@_saving">
                                <i class="bi bi-box-arrow-up me-1"></i> Retur / Koreksi Barang
                            </button>
                        }
                        @if (CanClose)
                        {
                            <button class="btn btn-sm btn-outline-dark" @onclick="ToggleCloseForm" disabled="@_saving">
                                <i class="bi bi-check2-all me-1"></i> Selesaikan PO
                            </button>
                        }
                        @if (CanCancel)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="ToggleCancelForm" disabled="@_saving">
                                <i class="bi bi-x-circle me-1"></i> Batalkan Order
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_showCloseForm)
            {
                <div class="card mt-3 border-dark">
                    <div class="card-header fw-semibold">Selesaikan PO</div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">
                            Sisa item yang belum dikirim pemasok dianggap selesai. Stok dan nilai terutang
                            hanya untuk barang yang sudah diterima.
                        </p>
                        <label class="form-label small">Alasan <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm mb-2" rows="2"
                                  @bind="_closeReason" placeholder="cth. Stok pemasok habis"></textarea>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="ToggleCloseForm" disabled="@_saving">Batal</button>
                            <button class="btn btn-sm btn-dark" @onclick="HandleClose"
                                    disabled="@(_saving || string.IsNullOrWhiteSpace(_closeReason))">
                                Ya, Selesaikan
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_showCancelForm)
            {
                <div class="card mt-3 border-danger">
                    <div class="card-header fw-semibold text-danger">Batalkan Order</div>
                    <div class="card-body">
                        <label class="form-label small">Alasan <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm mb-2" rows="2"
                                  @bind="_cancelReason" placeholder="cth. Pemasok kehabisan stok"></textarea>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="ToggleCancelForm" disabled="@_saving">Batal</button>
                            <button class="btn btn-sm btn-danger" @onclick="HandleCancel"
                                    disabled="@(_saving || string.IsNullOrWhiteSpace(_cancelReason))">
                                Ya, Batalkan
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private PurchaseOrderDto?  _po;
    private List<ProductDto>?  _products;

    private bool _receiving;
    private bool _returning;
    private bool _showCancelForm;
    private bool _showCloseForm;
    private string _cancelReason = "";
    private string _closeReason = "";
    private string _returnReason = "";
    private readonly Dictionary<Guid, decimal> _receiptQty = [];
    private readonly Dictionary<Guid, decimal> _returnQty  = [];

    private string? _error;
    private string? _notice;
    private bool    _saving;

    private decimal Total => _po?.Lines.Sum(l => l.OrderedQty * l.UnitCost) ?? 0;
    private decimal NetOwed => _po?.Lines.Sum(l => l.NetReceivedQty * l.UnitCost) ?? 0;
    private bool CanAct => _po is not null && _po.Status is "Draft" or "Confirmed" or "PartiallyReceived";
    private bool CanCancel => _po is not null && _po.Status is "Draft" or "Confirmed";
    private bool CanClose => _po is not null && _po.Status is "PartiallyReceived";
    private bool CanReturn => _po is not null && _po.Status is "PartiallyReceived" or "Received" or "Closed";
    private bool HasReceiptQty => _receiptQty.Values.Any(q => q > 0);
    private bool HasReturnQty => _returnQty.Values.Any(q => q > 0);

    protected override async Task OnInitializedAsync()
    {
        var productsTask = InventoryApi.GetProductsAsync(pageSize: 500);
        await LoadAsync();
        _products = (await productsTask)?.Items ?? [];
    }

    private async Task LoadAsync()
    {
        _po = await PoApi.GetByIdAsync(Id);
        if (_po is null) Navigation.NavigateTo("/purchase-orders");
    }

    private string ProductName(Guid productId)
        => _products?.FirstOrDefault(p => p.Id == productId)?.Name ?? productId.ToString()[..8];

    private async Task HandleConfirm()
    {
        _saving = true; _error = null;
        var error = await PoApi.ConfirmAsync(Id);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _notice = "Order berhasil dikonfirmasi.";
        await LoadAsync();
    }

    private void StartReceive()
    {
        _receiving = true;
        _returning = false;
        _showCancelForm = false;
        _showCloseForm = false;
        _receiptQty.Clear();
        foreach (var line in _po!.Lines)
        {
            var remaining = line.OrderedQty - line.ReceivedQty;
            _receiptQty[line.ProductId] = remaining > 0 ? remaining : 0;
        }
    }

    private void CancelReceive()
    {
        _receiving = false;
        _receiptQty.Clear();
    }

    private async Task HandleReceive()
    {
        var lines = _receiptQty
            .Where(kv => kv.Value > 0)
            .Select(kv => new ReceivePoLineInput(kv.Key, kv.Value))
            .ToList();

        if (lines.Count == 0) return;

        _saving = true; _error = null;
        var error = await PoApi.ReceiveAsync(Id, lines);
        _saving = false;
        if (error is not null) { _error = error; return; }

        _receiving = false;
        _receiptQty.Clear();
        _notice = "Barang berhasil diterima dan stok direkonsiliasi.";
        await LoadAsync();
    }

    private void StartReturn()
    {
        _returning = true;
        _receiving = false;
        _showCancelForm = false;
        _showCloseForm = false;
        _returnReason = "";
        _returnQty.Clear();
        foreach (var line in _po!.Lines)
            _returnQty[line.ProductId] = 0;
    }

    private void CancelReturn()
    {
        _returning = false;
        _returnQty.Clear();
        _returnReason = "";
    }

    private void FillFullReturn()
    {
        foreach (var line in _po!.Lines)
            _returnQty[line.ProductId] = line.NetReceivedQty > 0 ? line.NetReceivedQty : 0;
    }

    private async Task HandleReturn()
    {
        var lines = _returnQty
            .Where(kv => kv.Value > 0)
            .Select(kv => new ReturnPoLineInput(kv.Key, kv.Value))
            .ToList();

        if (lines.Count == 0 || string.IsNullOrWhiteSpace(_returnReason)) return;

        _saving = true; _error = null;
        var error = await PoApi.ReturnAsync(Id, lines, _returnReason);
        _saving = false;
        if (error is not null) { _error = error; return; }

        _returning = false;
        _returnQty.Clear();
        _returnReason = "";
        _notice = "Retur berhasil dicatat. Stok dan nilai terutang telah dikurangi.";
        await LoadAsync();
    }

    private void ToggleCloseForm()
    {
        _showCloseForm = !_showCloseForm;
        _showCancelForm = false;
        _closeReason = "";
    }

    private async Task HandleClose()
    {
        _saving = true; _error = null;
        var error = await PoApi.CloseAsync(Id, _closeReason);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _showCloseForm = false;
        _notice = "PO berhasil diselesaikan. Sisa item yang belum dikirim ditutup.";
        await LoadAsync();
    }

    private void ToggleCancelForm()
    {
        _showCancelForm = !_showCancelForm;
        _showCloseForm = false;
        _cancelReason = "";
    }

    private async Task HandleCancel()
    {
        _saving = true; _error = null;
        var error = await PoApi.CancelAsync(Id, _cancelReason);
        _saving = false;
        if (error is not null) { _error = error; return; }
        _showCancelForm = false;
        _notice = "Order berhasil dibatalkan.";
        await LoadAsync();
    }

    private string TermDisplay()
    {
        if (_po?.PaymentTermValue is not { } value || string.IsNullOrEmpty(_po.PaymentTermUnit))
            return "Tunai (tanpa tempo)";
        return $"{value} {UnitLabel(_po.PaymentTermUnit)}";
    }

    private DateTime EstimatedDueDate()
    {
        // Goods not yet received — estimate the due date from today.
        var value = _po?.PaymentTermValue ?? 0;
        return (_po?.PaymentTermUnit) switch
        {
            "Days"   => DateTime.Now.AddDays(value),
            "Weeks"  => DateTime.Now.AddDays(value * 7),
            "Months" => DateTime.Now.AddMonths(value),
            _        => DateTime.Now,
        };
    }

    private static string UnitLabel(string unit) => unit switch
    {
        "Days"   => "hari",
        "Weeks"  => "minggu",
        "Months" => "bulan",
        _        => unit.ToLowerInvariant(),
    };

    private static MarkupString StatusBadge(string status) => status switch
    {
        "Draft"             => (MarkupString)"<span class='badge bg-warning text-dark'>Draf</span>",
        "Confirmed"         => (MarkupString)"<span class='badge bg-primary'>Dikonfirmasi</span>",
        "PartiallyReceived" => (MarkupString)"<span class='badge bg-info text-dark'>Diterima Sebagian</span>",
        "Received"          => (MarkupString)"<span class='badge bg-success'>Diterima</span>",
        "Closed"            => (MarkupString)"<span class='badge text-bg-dark'>Selesai</span>",
        "Cancelled"         => (MarkupString)"<span class='badge bg-danger'>Dibatalkan</span>",
        _                   => (MarkupString)$"<span class='badge bg-secondary'>{status}</span>",
    };
}
