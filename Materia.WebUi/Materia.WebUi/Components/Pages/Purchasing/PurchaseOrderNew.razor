@page "/purchase-orders/new"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Materia.WebUi.Services
@inject PurchaseOrderApiClient PoApi
@inject SupplierApiClient       SupplierApi
@inject InventoryApiClient      InventoryApi
@inject NavigationManager       Navigation

<PageTitle>Order Pembelian Baru — Materia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/purchase-orders" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
    <h4 class="mb-0 fw-bold">Order Pembelian Baru</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </div>
}

<div class="row g-4">

    @* ── Left: supplier + add line ── *@
    <div class="col-lg-7">

        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-truck me-1"></i> Pemasok
            </div>
            <div class="card-body">
                <select class="form-select form-select-sm" @onchange="OnSupplierChanged">
                    <option value="">— pilih pemasok —</option>
                    @if (_suppliers is not null)
                    {
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    }
                </select>
                @if (_selectedSupplier is not null && _selectedSupplier.Catalog.Count == 0)
                {
                    <div class="alert alert-warning py-2 small mb-0 mt-2">
                        Pemasok ini belum memiliki katalog harga. Tetapkan harga beli terlebih dahulu di
                        <a href="/suppliers/@_selectedSupplier.Id">halaman pemasok</a>.
                    </div>
                }
            </div>
        </div>

        @if (_selectedSupplier is not null && _selectedSupplier.Catalog.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Tambah Item
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small">Produk</label>
                            <select class="form-select form-select-sm" @onchange="OnProductChanged">
                                <option value="">— pilih produk dari katalog —</option>
                                @foreach (var entry in _selectedSupplier.Catalog)
                                {
                                    <option value="@entry.ProductId">@ProductName(entry.ProductId)</option>
                                }
                            </select>
                        </div>
                        @if (_lineProductId != Guid.Empty)
                        {
                            <div class="col-12">
                                <div class="d-flex flex-wrap gap-3 small">
                                    <span>
                                        Harga beli terkini:
                                        <span class="fw-semibold text-success">
                                            Rp @_lineUnitCost.ToString("N0")
                                        </span>
                                        <span class="text-muted">/ @_lineUnit</span>
                                    </span>
                                    @if (_lineStock is not null)
                                    {
                                        @if (_lineStock.Quantity < 0)
                                        {
                                            <span class="text-danger fw-semibold">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                Stok: @_lineStock.Quantity.ToString("G29") @_lineStock.Unit — perlu pengadaan
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Stok saat ini: @_lineStock.Quantity.ToString("G29") @_lineStock.Unit
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small">Kuantitas (@_lineUnit)</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="_lineQty" min="0.001" step="0.001" placeholder="0" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button class="btn btn-sm btn-primary"
                                        @onclick="AddLine"
                                        disabled="@(_lineQty <= 0 || HasLine(_lineProductId))">
                                    <i class="bi bi-plus me-1"></i> Tambah
                                </button>
                            </div>
                            @if (HasLine(_lineProductId))
                            {
                                <div class="col-12">
                                    <small class="text-warning">Produk ini sudah ada di daftar order.</small>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            @if (_lines.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-list-check me-1"></i> Daftar Order (@_lines.Count)
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Harga</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _lines)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@ProductName(line.ProductId)</span>
                                            <span class="badge text-bg-light border ms-1 small">@line.Unit</span>
                                        </td>
                                        <td class="text-center">@line.Qty.ToString("G29")</td>
                                        <td class="text-end">Rp @line.UnitCost.ToString("N0")</td>
                                        <td class="text-end fw-semibold">Rp @((line.Qty * line.UnitCost).ToString("N0"))</td>
                                        <td class="text-end">
                                            <button class="btn btn-xs btn-outline-danger"
                                                    @onclick="() => _lines.Remove(line)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>

    @* ── Right: summary ── *@
    <div class="col-lg-5">
        <div class="card sticky-top" style="top:1rem">
            <div class="card-header fw-semibold">
                <i class="bi bi-receipt me-1"></i> Ringkasan
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td class="text-muted">Jumlah item</td>
                        <td class="text-end fw-semibold">@_lines.Count</td>
                    </tr>
                    <tr class="border-top">
                        <td class="fw-bold">Estimasi Total</td>
                        <td class="text-end fw-bold fs-5">Rp @Total.ToString("N0")</td>
                    </tr>
                </table>

                <p class="small text-muted">
                    Harga beli dikunci dari harga katalog terkini pemasok saat order dibuat.
                </p>

                <button class="btn btn-success w-100"
                        @onclick="HandleCreate"
                        disabled="@(_lines.Count == 0 || _processing)">
                    @if (_processing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>
                    }
                    Buat Order
                </button>
            </div>
        </div>
    </div>

</div>

@code {
    private List<SupplierDto>? _suppliers;
    private List<ProductDto>?  _products;
    private SupplierDto?       _selectedSupplier;

    private Guid     _lineProductId;
    private decimal  _lineUnitCost;
    private string   _lineUnit = "";
    private decimal  _lineQty;
    private StockDto? _lineStock;

    private readonly List<PoLine> _lines = [];

    private string? _error;
    private bool    _processing;

    private decimal Total => _lines.Sum(l => l.Qty * l.UnitCost);

    protected override async Task OnInitializedAsync()
    {
        var productsTask  = InventoryApi.GetProductsAsync(pageSize: 500, isActive: true);
        _suppliers = await SupplierApi.GetSuppliersAsync(activeOnly: true) ?? [];
        _products  = (await productsTask)?.Items ?? [];
    }

    private async Task OnSupplierChanged(ChangeEventArgs e)
    {
        ResetLineForm();
        _lines.Clear();

        _selectedSupplier = Guid.TryParse(e.Value?.ToString(), out var id)
            ? await SupplierApi.GetSupplierByIdAsync(id)
            : null;
    }

    private async Task OnProductChanged(ChangeEventArgs e)
    {
        ResetLineForm();

        if (!Guid.TryParse(e.Value?.ToString(), out var pid) || _selectedSupplier is null)
            return;

        var entry  = _selectedSupplier.Catalog.FirstOrDefault(c => c.ProductId == pid);
        var latest = entry?.Prices.OrderByDescending(p => p.EffectiveFrom).FirstOrDefault();
        if (latest is null) return;

        _lineProductId = pid;
        _lineUnitCost  = latest.Amount;
        _lineUnit      = latest.Unit;
        _lineStock     = await InventoryApi.GetStockByProductIdAsync(pid);
    }

    private void AddLine()
    {
        if (_lineProductId == Guid.Empty || _lineQty <= 0 || HasLine(_lineProductId)) return;

        _lines.Add(new PoLine(_lineProductId, _lineQty, _lineUnitCost, _lineUnit));
        ResetLineForm();
    }

    private async Task HandleCreate()
    {
        if (_selectedSupplier is null) return;

        _processing = true;
        _error      = null;

        var inputs = _lines.Select(l => new CreatePoLineInput(l.ProductId, l.Qty)).ToList();
        var (id, error) = await PoApi.CreateAsync(_selectedSupplier.Id, inputs);

        _processing = false;
        if (error is not null) { _error = error; return; }

        Navigation.NavigateTo($"/purchase-orders/{id}");
    }

    private bool HasLine(Guid productId) => _lines.Any(l => l.ProductId == productId);

    private string ProductName(Guid productId)
        => _products?.FirstOrDefault(p => p.Id == productId)?.Name ?? productId.ToString()[..8];

    private void ResetLineForm()
    {
        _lineProductId = Guid.Empty;
        _lineUnitCost  = 0;
        _lineUnit      = "";
        _lineQty       = 0;
        _lineStock     = null;
    }

    private sealed record PoLine(Guid ProductId, decimal Qty, decimal UnitCost, string Unit);
}
