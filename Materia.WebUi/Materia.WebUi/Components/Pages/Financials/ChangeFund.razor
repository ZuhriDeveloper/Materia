@page "/financials/change-fund"
@attribute [Authorize(Roles = "Admin,Cashier")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Materia.WebUi.Services
@inject ChangeFundApiClient Api

<PageTitle>Uang Kembalian — Materia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Uang Kembalian</h4>
</div>

@* ── Balance card ── *@
<div class="card mb-4 border-success">
    <div class="card-body py-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-cash-coin text-success" style="font-size:2rem"></i>
            <div>
                <div class="text-muted small">Total Uang Kembalian Disiapkan</div>
                <div class="fw-bold fs-4 text-success">
                    @if (_data is null)
                    {
                        <span class="placeholder col-4"></span>
                    }
                    else
                    {
                        <span>Rp @_data.TotalBalance.ToString("N0")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Manual deposit form (Admin only) ── *@
<AuthorizeView Roles="Admin" Context="authCtx">
    <Authorized>
        <div class="card mb-4" style="max-width:560px">
            <div class="card-header fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Tambah Deposit Manual
            </div>
            <div class="card-body">
                @if (_depositErrors is { Count: > 0 })
                {
                    <div class="alert alert-danger py-2">
                        <ul class="mb-0 ps-3">
                            @foreach (var e in _depositErrors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }
                <EditForm Model="_form" OnValidSubmit="HandleDepositSubmit">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Jumlah (Rp) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.Amount"
                                         placeholder="cth. 200000" />
                            <ValidationMessage For="() => _form.Amount" class="small text-danger" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Catatan</label>
                            <InputText class="form-control" @bind-Value="_form.Notes"
                                       placeholder="Opsional" />
                            <ValidationMessage For="() => _form.Notes" class="small text-danger" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i> Simpan Deposit
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        @* ── Withdrawal / correction form (Admin only) ── *@
        <div class="card mb-4" style="max-width:560px">
            <div class="card-header fw-semibold">
                <i class="bi bi-dash-circle me-1"></i> Koreksi / Penarikan
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Catat penarikan uang kembalian untuk mengoreksi deposit yang salah.
                    Saldo tidak boleh menjadi negatif.
                </p>
                @if (_withdrawErrors is { Count: > 0 })
                {
                    <div class="alert alert-danger py-2">
                        <ul class="mb-0 ps-3">
                            @foreach (var e in _withdrawErrors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }
                <EditForm Model="_withdrawForm" OnValidSubmit="HandleWithdrawSubmit">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Jumlah (Rp) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_withdrawForm.Amount"
                                         placeholder="cth. 50000" />
                            <ValidationMessage For="() => _withdrawForm.Amount" class="small text-danger" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Alasan <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_withdrawForm.Reason"
                                       placeholder="cth. Koreksi deposit ganda" />
                            <ValidationMessage For="() => _withdrawForm.Reason" class="small text-danger" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-outline-danger btn-sm" disabled="@_withdrawing">
                            @if (_withdrawing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-dash-lg me-1"></i> Catat Penarikan
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@* ── Deposit list ── *@
@if (_data is null)
{
    <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Memuat…</div>
}
else if (_data.Items.Count == 0)
{
    <div class="alert alert-info">Belum ada catatan uang kembalian.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tanggal</th>
                        <th>Sumber</th>
                        <th>No. Referensi</th>
                        <th>Catatan</th>
                        <th>Dicatat Oleh</th>
                        <th class="text-end">Jumlah</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _data.Items)
                    {
                        <tr>
                            <td class="small text-muted">
                                @d.RecordedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @SourceLabel(d.Source)
                                </span>
                            </td>
                            <td class="small font-monospace text-muted">
                                @(string.IsNullOrWhiteSpace(d.SourceReferenceNo) ? "—" : d.SourceReferenceNo)
                            </td>
                            <td class="small text-muted">
                                @(string.IsNullOrWhiteSpace(d.Notes) ? "—" : d.Notes)
                            </td>
                            <td class="small">@d.RecordedBy</td>
                            <td class="text-end fw-semibold">Rp @d.Amount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-end fw-semibold">Total halaman ini</td>
                        <td class="text-end fw-bold">Rp @_data.Items.Sum(i => i.Amount).ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @if (_data.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, _data.TotalCount))
                dari @_data.TotalCount deposit
            </small>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" disabled="@(_page <= 1)"
                        @onclick="() => ChangePage(_page - 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="btn btn-outline-secondary" disabled="@(_page >= _data.TotalPages)"
                        @onclick="() => ChangePage(_page + 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
}

@* ── Withdrawal list ── *@
@if (_withdrawals is { Items.Count: > 0 })
{
    <h6 class="fw-bold mt-4 mb-2 text-danger">
        <i class="bi bi-dash-circle me-1"></i> Penarikan / Koreksi
    </h6>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tanggal</th>
                        <th>Alasan</th>
                        <th>Dicatat Oleh</th>
                        <th class="text-end">Jumlah</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in _withdrawals.Items)
                    {
                        <tr>
                            <td class="small text-muted">
                                @w.RecordedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                            </td>
                            <td class="small">@w.Reason</td>
                            <td class="small">@w.RecordedBy</td>
                            <td class="text-end fw-semibold text-danger">− Rp @w.Amount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private ChangeFundResultDto?           _data;
    private ChangeFundWithdrawalResultDto? _withdrawals;
    private int                            _page     = 1;
    private const int                      _pageSize = 20;

    private readonly DepositForm _form = new();
    private List<string>?        _depositErrors;
    private bool                 _saving;

    private readonly WithdrawForm _withdrawForm = new();
    private List<string>?         _withdrawErrors;
    private bool                  _withdrawing;

    // Idempotency keys: generated ONCE per pending form, reused on every retry so a
    // timed-out-and-retried submit can't double-post. Regenerated only after a success.
    private Guid _depositKey  = Guid.NewGuid();
    private Guid _withdrawKey = Guid.NewGuid();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _data        = await Api.GetAsync(_page, _pageSize);
        _withdrawals = await Api.GetWithdrawalsAsync(1, _pageSize);
    }

    private async Task HandleDepositSubmit()
    {
        _depositErrors = null;
        _saving = true;

        var (_, errors) = await Api.RecordDepositAsync(
            _form.Amount,
            string.IsNullOrWhiteSpace(_form.Notes) ? null : _form.Notes.Trim(),
            _depositKey);

        _saving = false;

        if (errors is not null) { _depositErrors = errors; return; }

        _form.Amount = 0;
        _form.Notes  = null;
        _depositKey  = Guid.NewGuid();   // fresh key for the next deposit
        _page        = 1;
        await LoadAsync();
    }

    private async Task HandleWithdrawSubmit()
    {
        _withdrawErrors = null;
        _withdrawing = true;

        var (_, errors) = await Api.RecordWithdrawalAsync(
            _withdrawForm.Amount,
            _withdrawForm.Reason.Trim(),
            _withdrawKey);

        _withdrawing = false;

        if (errors is not null) { _withdrawErrors = errors; return; }

        _withdrawForm.Amount = 0;
        _withdrawForm.Reason = string.Empty;
        _withdrawKey         = Guid.NewGuid();   // fresh key for the next withdrawal
        _page                = 1;
        await LoadAsync();
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private static string SourceLabel(string source) => source switch
    {
        "ManualEntry"       => "Input Manual",
        "PettyCashExchange" => "Tukar Uang Kembalian",
        _                   => source,
    };

    private sealed class DepositForm
    {
        [Range(0.01, double.MaxValue, ErrorMessage = "Jumlah harus lebih dari nol.")]
        public decimal Amount { get; set; }

        [MaxLength(500)]
        public string? Notes { get; set; }
    }

    private sealed class WithdrawForm
    {
        [Range(0.01, double.MaxValue, ErrorMessage = "Jumlah harus lebih dari nol.")]
        public decimal Amount { get; set; }

        [Required(ErrorMessage = "Alasan penarikan wajib diisi.")]
        [MaxLength(300, ErrorMessage = "Alasan maksimal 300 karakter.")]
        public string Reason { get; set; } = string.Empty;
    }
}
