@using Microsoft.AspNetCore.Components.Authorization

<MudNavMenu Class="pt-2">

    <MudNavLink Href="" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home">
        Beranda
    </MudNavLink>

    @* ── Platform (SuperAdmin only) ── *@
    <AuthorizeView Roles="SuperAdmin">

        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Platform
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="platform/stores" Icon="@Icons.Material.Filled.StoreMallDirectory">
            Toko
        </MudNavLink>
        <MudNavLink Href="platform/users" Icon="@Icons.Material.Filled.ManageAccounts">
            Pengguna
        </MudNavLink>

    </AuthorizeView>

    <AuthorizeView Roles="Admin,Cashier">

        @* Section: Penjualan *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Penjualan
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="pos" Icon="@Icons.Material.Filled.Store">
            Kasir
        </MudNavLink>
        <MudNavLink Href="sales" Icon="@Icons.Material.Filled.Receipt">
            Daftar Penjualan
        </MudNavLink>

        @* Section: Pelanggan *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Pelanggan
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="customers" Icon="@Icons.Material.Filled.Group">
            Pelanggan
        </MudNavLink>
        <MudNavLink Href="receivables" Icon="@Icons.Material.Filled.RequestQuote">
            Piutang
        </MudNavLink>

        @* Section: Kas Kecil *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Kas Kecil
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="petty-cash" Icon="@Icons.Material.Filled.Payments">
            Kas Kecil
        </MudNavLink>
        <MudNavLink Href="financials/change-fund" Icon="@Icons.Material.Filled.CurrencyExchange">
            Uang Kembalian
        </MudNavLink>

    </AuthorizeView>

    <AuthorizeView Roles="Admin">

        @* Section: Laporan *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Laporan
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="financials" Icon="@Icons.Material.Filled.BarChart">
            Laporan Keuangan
        </MudNavLink>
        <MudNavLink Href="stock-report" Icon="@Icons.Material.Filled.Assessment">
            Laporan Stok
        </MudNavLink>

    </AuthorizeView>

    @* ── Inventaris + Pengadaan (Admin & Gudang) ── *@
    <AuthorizeView Roles="Admin,Gudang">

        @* Section: Inventaris *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Inventaris
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="products"   Icon="@Icons.Material.Filled.Inventory2">Produk</MudNavLink>
        <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Label">Kategori</MudNavLink>
        <MudNavLink Href="units"      Icon="@Icons.Material.Filled.Straighten">Satuan</MudNavLink>

        @* Section: Pengadaan *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Pengadaan
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="suppliers"       Icon="@Icons.Material.Filled.LocalShipping">Pemasok</MudNavLink>
        <MudNavLink Href="purchase-orders" Icon="@Icons.Material.Filled.Assignment">Order Pembelian</MudNavLink>
        <MudNavLink Href="import-pembelian" Icon="@Icons.Material.Filled.DocumentScanner">Import Pembelian</MudNavLink>

    </AuthorizeView>

    @* ── Pengaturan (Admin only) ── *@
    <AuthorizeView Roles="Admin">

        @* Section: Pengaturan *@
        @if (_drawerOpen)
        {
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-0 d-block"
                     Style="font-size:.6rem;letter-spacing:.1em;
                            color:var(--mud-palette-drawer-text);opacity:.5">
                Pengaturan
            </MudText>
        }
        else
        {
            <MudDivider Class="my-2 mx-2" />
        }

        <MudNavLink Href="store/settings" Icon="@Icons.Material.Filled.Settings">
            Pengaturan Toko
        </MudNavLink>

    </AuthorizeView>

</MudNavMenu>

@code {
    [CascadingParameter(Name = "DrawerOpen")]
    private bool _drawerOpen { get; set; }
}
