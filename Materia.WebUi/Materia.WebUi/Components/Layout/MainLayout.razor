@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject ThemeState ThemeState
@inject IJSRuntime JS
@implements IDisposable

@* All MudBlazor global providers live here inside the Routes interactive circuit.
   ThemeProvider shares the exact same ThemeState instance as the toggle button.
   Popup providers are co-located so they participate in the same DI scope. *@
<MudThemeProvider Theme="@MateriaTheme.Default" IsDarkMode="@ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    @* ── App Bar ── *@
    <MudAppBar Elevation="0" Dense="true"
               Style="border-bottom:1px solid var(--mud-palette-divider);">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-1"
                 Style="font-weight:700;letter-spacing:-.4px;user-select:none">
            Materia
        </MudText>

        <MudSpacer />

        <MudTooltip Text="@(ThemeState.IsDarkMode ? "Mode Terang" : "Mode Gelap")"
                    Placement="Placement.Bottom">
            <MudIconButton Icon="@(ThemeState.IsDarkMode
                                     ? Icons.Material.Filled.LightMode
                                     : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode" />
        </MudTooltip>

        @* CSS-only dropdown: this layout renders statically (no Blazor interactivity),
           so the user menu uses :hover / :focus-within instead of an @@onclick handler.
           Change-password is a plain link; logout keeps its form POST (+ antiforgery). *@
        <AuthorizeView Context="auth">
            <Authorized>
                <div class="materia-user-menu">
                    <button type="button" class="materia-user-trigger">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Style="font-size:.75rem">
                            @(auth.User.Identity?.Name?[..1].ToUpperInvariant() ?? "?")
                        </MudAvatar>
                        <span class="materia-user-name d-none d-sm-inline">
                            @auth.User.Identity?.Name
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="materia-user-dropdown">
                        <div class="materia-user-dropdown-header">@auth.User.Identity?.Name</div>
                        <a class="materia-user-item" href="/account/change-password">
                            <i class="bi bi-key me-2"></i>Ubah Kata Sandi
                        </a>
                        <form method="post" action="/account/logout" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit" class="materia-user-item">
                                <i class="bi bi-box-arrow-right me-2"></i>Keluar
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

    </MudAppBar>

    @* ── Drawer ── *@
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Always"
               Style="border-right:1px solid rgba(255,255,255,.06)">

        <MudDrawerHeader Dense="true" Class="px-4"
                         Style="min-height:48px;align-items:center;
                                border-bottom:1px solid rgba(255,255,255,.06)">
            @if (_drawerOpen)
            {
                <MudText Typo="Typo.subtitle2"
                         Style="font-weight:700;color:var(--mud-palette-drawer-text);
                                letter-spacing:-.2px;user-select:none">
                    Materia
                </MudText>
            }
        </MudDrawerHeader>

        <CascadingValue Value="_drawerOpen" Name="DrawerOpen">
            <NavMenu />
        </CascadingValue>

    </MudDrawer>

    @* ── Main content ── *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-5 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
        => ThemeState.OnChanged += OnThemeChanged;

    // Restore persisted preferences on the first interactive render.
    // JSInterop is only safe after the circuit connects (OnAfterRenderAsync).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var darkPref    = await JS.InvokeAsync<string?>("localStorage.getItem", "materia_dark");
            var sidebarPref = await JS.InvokeAsync<string?>("localStorage.getItem", "materia_sidebar");

            ThemeState.SetDarkMode(darkPref == "1");
            _drawerOpen = sidebarPref != "1";
        }
        catch { /* localStorage not available (private/incognito edge cases) */ }

        StateHasChanged();
    }

    private void OnThemeChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => ThemeState.OnChanged -= OnThemeChanged;

    private async Task ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "materia_sidebar", _drawerOpen ? "0" : "1"); }
        catch { }
    }

    private async Task ToggleDarkMode()
    {
        ThemeState.Toggle();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "materia_dark", ThemeState.IsDarkMode ? "1" : "0"); }
        catch { }
    }
}
